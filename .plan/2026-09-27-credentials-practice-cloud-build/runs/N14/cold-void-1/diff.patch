+/// POSTs `body` to `sub`, retrying transient failures until [`MAX_ATTEMPTS`]
+/// or `deadline`, and reports the final outcome; `true` if delivered.
+async fn deliver(
+    transport: &dyn WebhookTransport,
+    sink: &dyn DeliverySink,
+    tenant: &str,
+    sub: &Subscription,
+    body: &[u8],
+    deadline: Instant,
+) -> bool {
+    let mut backoff = RETRY_BACKOFF;
+    let mut attempt = 1;
+    let outcome = loop {
+        let attempt_deadline = (Instant::now() + ATTEMPT_TIMEOUT).min(deadline);
+        let response = match tokio::time::timeout_at(attempt_deadline, transport.post(&sub.url, body)).await {
+            Ok(response) => response,
+            Err(_) => Err(WebhookError::Unreachable(format!("{} (no answer in time)", sub.url))),
+        };
+        let outcome = match &response {
+            Ok(status) if (200..300).contains(status) => Outcome::Delivered { status: *status },
             Ok(status) => Outcome::Failed { reason: format!("HTTP {status}") },
             Err(error) => Outcome::Failed { reason: error.to_string() },
         };
-        let delivered = matches!(outcome, Outcome::Delivered { .. });
-        self.sink.record(DeliveryEvent { tenant: tenant.to_string(), subscription: sub.id.clone(), outcome });
-        delivered
-    }
+        if !outcome.retryable(&response) || attempt >= MAX_ATTEMPTS || Instant::now() + backoff >= deadline {
+            break match outcome {
+                Outcome::Failed { reason } if attempt > 1 => Outcome::Failed { reason: format!("{reason} (after {attempt} attempts)") },
+                outcome => outcome,
+            };
+        }
+        tokio::time::sleep(backoff).await;
+        backoff *= 2;
+        attempt += 1;
+    };
+    let delivered = matches!(outcome, Outcome::Delivered { .. });
+    sink.record(DeliveryEvent { tenant: tenant.to_string(), subscription: sub.id.clone(), outcome });
+    delivered
 }
