+/// A tenant with a large settings partition: tens of thousands of
+/// preferences alongside its webhook subscriptions.
+fn large_tenant(settings: &SettingsStore, transport: &HermeticTransport, tenant: &str, host: &str) -> Vec<String> {
+    for i in 0..30_000 {
+        settings.put(Setting::new(tenant, &format!("pref/{i:05}"), "preference", json!({ "n": i })));
+    }
+    small_tenant(settings, transport, tenant, host)
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_tenant_with_many_settings_is_notified() {
+    let rig = rig();
+    let urls = large_tenant(&rig.settings, &rig.transport, HARBOUR, "door.harbourclub.example");
+
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+
+    for url in &urls {
+        assert_eq!(rig.transport.received(url).len(), 1, "{url}");
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_hanging_endpoint_does_not_hold_up_the_other_subscribers() {
+    let rig = rig();
+    // Sorts before the healthy subscribers.
+    subscribe(&rig.settings, HARBOUR, "a-hangs", "https://stuck.harbourclub.example/hooks");
+    rig.transport.route("https://stuck.harbourclub.example/hooks", Endpoint::Hang);
+    let urls = small_tenant(&rig.settings, &rig.transport, HARBOUR, "door.harbourclub.example");
+
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+
+    for url in &urls {
+        assert_eq!(rig.transport.received(url).len(), 1, "{url}");
+    }
+    let stuck: Vec<DeliveryEvent> = rig.sink.events().into_iter().filter(|e| e.subscription == "a-hangs").collect();
+    assert_eq!(stuck.len(), 1, "the hanging delivery is reported");
+    assert!(matches!(&stuck[0].outcome, Outcome::Failed { .. }));
+}
+
+#[tokio::test(start_paused = true)]
+async fn slow_endpoints_are_called_concurrently() {
+    let rig = rig();
+    let urls: Vec<String> = (0..20)
+        .map(|i| {
+            let url = format!("https://slow.harbourclub.example/hooks/{i}");
+            subscribe(&rig.settings, HARBOUR, &format!("slow-{i:02}"), &url);
+            rig.transport.route(&url, Endpoint::slow(std::time::Duration::from_secs(1)));
+            url
+        })
+        .collect();
+
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+
+    for url in &urls {
+        assert_eq!(rig.transport.received(url).len(), 1, "{url}");
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn the_notifier_is_not_healthy_when_a_fan_out_does_not_finish() {
+    let rig = rig();
+    small_tenant(&rig.settings, &rig.transport, HARBOUR, "door.harbourclub.example");
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+    assert!(rig.notifier.canary_healthy());
+
+    // The settings store stops answering in time for this tenant's next change.
+    let stalled = Arc::new(SettingsStore::new());
+    let transport = Arc::new(HermeticTransport::new());
+    let notifier = Notifier::new(stalled.clone(), transport.clone(), Arc::new(MemorySink::default()));
+    for i in 0..300_000 {
+        stalled.put(Setting::new(HARBOUR, &format!("hook/{i:06}"), WEBHOOK_KIND, json!({ "url": "https://door.harbourclub.example/h" })));
+    }
+    transport.route_host("door.harbourclub.example", Endpoint::ok());
+    notifier.notify(&revoked(HARBOUR, 7)).await;
+    assert!(!notifier.canary_healthy());
+}
