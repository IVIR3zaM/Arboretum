diff --git a/test/deliveries.test.ts b/test/deliveries.test.ts
index e82530b..dd09c59 100644
--- a/test/deliveries.test.ts
+++ b/test/deliveries.test.ts
@@ -126,3 +126,50 @@ test("processQueue de-duplicates a repeated event id and ships once", () => {
   assert.equal(second.length, 0);
   assert.equal(svc.deliveriesFor("cust-1")[0].status, "delivered");
 });
+
+// --- cutoff honours the subscription's timezone (ticket #4471) ----------------
+// These must pass regardless of the host's TZ; `npm test` is run under several.
+
+import { cutoffInstant } from "../src/cutoff.ts";
+
+test("Tokyo cutoff is 18:00 JST, not 18:00 server time", () => {
+  const tokyo = { ...sub, timezone: "Asia/Tokyo" };
+  // Delivery 2026-03-20 -> cutoff 2026-03-18 18:00 JST = 09:00Z.
+  assert.equal(cutoffInstant("2026-03-20", tokyo).toISOString(), "2026-03-18T09:00:00.000Z");
+  assert.equal(isBeforeCutoff(new Date("2026-03-18T08:59:59Z"), "2026-03-20", tokyo), true);
+  assert.equal(isBeforeCutoff(new Date("2026-03-18T09:00:00Z"), "2026-03-20", tokyo), false);
+});
+
+test("Honolulu cutoff is 18:00 HST, not 18:00 server time", () => {
+  const hnl = { ...sub, timezone: "Pacific/Honolulu" };
+  // 2026-03-18 18:00 HST (UTC-10) = 2026-03-19 04:00Z.
+  assert.equal(cutoffInstant("2026-03-20", hnl).toISOString(), "2026-03-19T04:00:00.000Z");
+  assert.equal(isBeforeCutoff(new Date("2026-03-19T03:59:59Z"), "2026-03-20", hnl), true);
+  assert.equal(isBeforeCutoff(new Date("2026-03-19T04:00:00Z"), "2026-03-20", hnl), false);
+});
+
+test("cutoff tracks DST: same local hour, different UTC offset", () => {
+  const la = { ...sub, timezone: "America/Los_Angeles" };
+  // PST (UTC-8) before 2026-03-08, PDT (UTC-7) after.
+  assert.equal(cutoffInstant("2026-03-06", la).toISOString(), "2026-03-05T02:00:00.000Z");
+  assert.equal(cutoffInstant("2026-03-13", la).toISOString(), "2026-03-12T01:00:00.000Z");
+});
+
+test("cutoff hour inside a DST gap resolves to the end of the gap", () => {
+  const la = { ...sub, timezone: "America/Los_Angeles", cutoffHour: 2 };
+  // 02:00 doesn't exist on 2026-03-08 in LA; clocks jump to 03:00 PDT = 10:00Z.
+  assert.equal(cutoffInstant("2026-03-10", la).toISOString(), "2026-03-08T10:00:00.000Z");
+});
+
+test("ambiguous cutoff hour (DST fall-back) uses the earlier occurrence", () => {
+  const la = { ...sub, timezone: "America/Los_Angeles", cutoffHour: 1 };
+  // 01:00 happens twice on 2026-11-01; first is 01:00 PDT = 08:00Z.
+  assert.equal(cutoffInstant("2026-11-03", la).toISOString(), "2026-11-01T08:00:00.000Z");
+});
+
+test("nextDeliveryDate uses the customer's local date, not UTC", () => {
+  const hnl = { ...sub, timezone: "Pacific/Honolulu", cutoffDaysBefore: 0, cutoffHour: 22 };
+  // 21:00 HST on 2026-03-20 (already 03-21 in UTC); the 03-20 box is open until 22:00 HST.
+  assert.equal(nextDeliveryDate(hnl, new Date("2026-03-21T07:00:00Z")), "2026-03-20");
+  assert.equal(nextDeliveryDate(hnl, new Date("2026-03-21T08:00:00Z")), "2026-03-27");
+});
