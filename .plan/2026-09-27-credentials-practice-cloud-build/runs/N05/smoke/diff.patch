 export function cutoffInstant(deliveryDate: string, sub: Subscription): Date {
   const cutoffDay = shiftDate(deliveryDate, -sub.cutoffDaysBefore);
   const [y, m, d] = cutoffDay.split("-").map(Number);
-  // Construct the wall-clock cutoff time and return it as an instant.
-  return new Date(y, m - 1, d, sub.cutoffHour, 0, 0, 0);
+  // Interpret the wall-clock cutoff in the subscription's timezone, never the
+  // host's: `new Date(y, m, d, h)` would silently use the server's zone.
+  return zonedTimeToInstant(y, m, d, sub.cutoffHour, sub.timezone);
+}
+
+/**
+ * The absolute instant at which the wall clock in `timeZone` reads
+ * `y-m-d hour:00`. If that wall time falls in a DST gap it resolves to the
+ * instant just after the gap (e.g. 02:00 on a spring-forward day -> 03:00);
+ * if it is ambiguous (fall-back) the earlier occurrence is used.
+ */
+export function zonedTimeToInstant(y: number, m: number, d: number, hour: number, timeZone: string): Date {
+  const wall = Date.UTC(y, m - 1, d, hour, 0, 0, 0);
+  // Offsets either side of the target; pick the one that round-trips.
+  const offBefore = tzOffsetMs(new Date(wall - 86_400_000), timeZone);
+  const offAfter = tzOffsetMs(new Date(wall + 86_400_000), timeZone);
+  const candidates = [wall - offBefore, wall - offAfter].sort((a, b) => a - b);
+  for (const t of candidates) {
+    if (t + tzOffsetMs(new Date(t), timeZone) === wall) return new Date(t);
+  }
+  // Wall time doesn't exist (DST gap): the gap ends at this instant.
+  return new Date(wall - offBefore);
+}
+
+/** Offset (ms) of `timeZone` from UTC at instant `at`: local wall time minus UTC. */
+function tzOffsetMs(at: Date, timeZone: string): number {
+  const p = zonedParts(at, timeZone);
+  const asUtc = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second);
+  return asUtc - Math.floor(at.getTime() / 1000) * 1000;
+}
+
+const formatters = new Map<string, Intl.DateTimeFormat>();
+
+function zonedParts(at: Date, timeZone: string) {
+  let fmt = formatters.get(timeZone);
+  if (!fmt) {
+    fmt = new Intl.DateTimeFormat("en-US", {
+      timeZone,
+      hourCycle: "h23",
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+      hour: "2-digit",
+      minute: "2-digit",
+      second: "2-digit",
+    });
+    formatters.set(timeZone, fmt);
+  }
+  const get = (type: string) => Number(fmt.formatToParts(at).find((x) => x.type === type)!.value);
+  return {
+    year: get("year"),
+    month: get("month"),
+    day: get("day"),
+    hour: get("hour"),
+    minute: get("minute"),
+    second: get("second"),
+  };
+}
+
+/** The calendar date (YYYY-MM-DD) it is in `timeZone` at instant `at`. */
+export function localIsoDate(at: Date, timeZone: string): string {
+  const p = zonedParts(at, timeZone);
+  return `${p.year}-${String(p.month).padStart(2, "0")}-${String(p.day).padStart(2, "0")}`;
 }
 
