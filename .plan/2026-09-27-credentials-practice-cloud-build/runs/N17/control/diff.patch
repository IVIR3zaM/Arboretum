+// Ticket #4163: a tenant with many settings, many subscribers, or one endpoint
+// that never answers must still have every other subscriber told.
+
+/// A large account: thousands of settings, dozens of relying parties.
+fn large_tenant(settings: &SettingsStore, transport: &HermeticTransport, tenant: &str, host: &str) -> Vec<String> {
+    for i in 0..25_000 {
+        settings.put(Setting::new(tenant, &format!("pref/{i:05}"), "preference", json!({ "n": i })));
+    }
+    (1..=80)
+        .map(|i| {
+            let url = format!("https://{host}/hooks/{i}");
+            subscribe(settings, tenant, &format!("rp-{i:02}"), &url);
+            transport.route(&url, Endpoint::ok());
+            url
+        })
+        .collect()
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_large_tenant_is_notified() {
+    let rig = rig();
+    let urls = large_tenant(&rig.settings, &rig.transport, CEDAR, "gate.cedarrowing.example");
+
+    rig.notifier.notify(&revoked(CEDAR, 7)).await;
+
+    for url in &urls {
+        assert_eq!(rig.transport.received(url).len(), 1, "{url}");
+    }
+    assert!(rig.notifier.canary_healthy());
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_hanging_endpoint_does_not_hold_up_the_others() {
+    let rig = rig();
+    let urls = small_tenant(&rig.settings, &rig.transport, HARBOUR, "door.harbourclub.example");
+    subscribe(&rig.settings, HARBOUR, "rp-0-hangs", "https://hang.harbourclub.example/hooks");
+    rig.transport.route("https://hang.harbourclub.example/hooks", Endpoint::Hang);
+    subscribe(&rig.settings, HARBOUR, "rp-0-slow", "https://slow.harbourclub.example/hooks");
+    rig.transport.route("https://slow.harbourclub.example/hooks", Endpoint::slow(std::time::Duration::from_secs(1)));
+
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+
+    for url in &urls {
+        assert_eq!(rig.transport.received(url).len(), 1, "{url}");
+    }
+    assert_eq!(rig.transport.received("https://slow.harbourclub.example/hooks").len(), 1);
+    let hung: Vec<DeliveryEvent> = rig.sink.events().into_iter().filter(|e| e.subscription == "rp-0-hangs").collect();
+    assert!(!hung.is_empty() && hung.iter().all(|e| matches!(e.outcome, Outcome::Failed { .. })), "{hung:?}");
+}
+
+#[tokio::test(start_paused = true)]
+async fn an_unreachable_endpoint_is_retried_and_each_attempt_reported() {
+    let rig = rig();
+    subscribe(&rig.settings, HARBOUR, "rp-gone", "https://gone.harbourclub.example/hooks");
+
+    rig.notifier.notify(&revoked(HARBOUR, 7)).await;
+
+    let attempts = rig.sink.events().into_iter().filter(|e| e.subscription == "rp-gone").count();
+    assert_eq!(attempts as u32, credentials_backend::notifier::MAX_ATTEMPTS);
+}
