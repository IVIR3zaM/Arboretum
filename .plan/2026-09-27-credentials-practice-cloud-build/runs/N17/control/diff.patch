+import 'dart:convert';
+
+import 'package:credentials_app/credentials_app.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ssi/ssi.dart';
+
+import 'fake_issuer_client.dart';
+import 'fixtures.dart';
+
+const credentialId = 'urn:uuid:5b1d7c2e-0f7a-4c3e-9d0b-6a2f1e8c4d11';
+
+Future<WalletService> walletHoldingMembership() async {
+  final wallet = WalletService(
+    issuer: FakeIssuerClient(),
+    newKey: () => HolderKey.fromSeed(holderSeed),
+    clock: () => DateTime.utc(2026, 6, 1),
+  );
+  await wallet.requestCredential('MembershipCredential');
+  return wallet;
+}
+
+PresentationRequest requestFor(Map<String, dynamic> credentialQuery) {
+  final json = doorRequest();
+  json['dcql_query'] = {
+    'credentials': [credentialQuery],
+  };
+  return PresentationRequest.fromJson(json);
+}
+
+void main() {
+  test('answers the door request with the credential and the asked-for claim '
+      'only', () async {
+    final wallet = await walletHoldingMembership();
+
+    final vp = await wallet.createPresentation(
+      credentialId,
+      PresentationRequest.fromJson(doorRequest()),
+    );
+
+    expect(vp['type'], ['VerifiablePresentation']);
+    expect(vp['holder'], holderDid);
+    expect(vp['nonce'], 'n-8f3Kq2xWz0Lb');
+    expect(vp['domain'], 'door-scanner.members.test');
+    expect(
+      vp['verifiableCredential'],
+      membershipIssuance()['credential'],
+      reason: 'the issuer-signed credential is passed on unchanged',
+    );
+    expect(vp['disclosures'], [
+      {'salt': 'Qg8wYx1dLr0pVb3kTz7sNw', 'name': 'member', 'value': true},
+    ]);
+  });
+
+  test('is signed by the holder key over the canonical presentation', () async {
+    final wallet = await walletHoldingMembership();
+    final vp = await wallet.createPresentation(
+      credentialId,
+      PresentationRequest.fromJson(doorRequest()),
+    );
+
+    final proof = vp['proof'] as Map<String, dynamic>;
+    expect(proof['type'], 'Ed25519Signature2020');
+    expect(proof['proofPurpose'], 'authentication');
+    expect(proof['verificationMethod'], wallet.holderKey().keyId);
+    expect(proof['created'], 1780272000);
+
+    final unsigned = Map<String, dynamic>.of(vp)..remove('proof');
+    final signingInput = utf8.encode(JcsUtil.canonicalize(unsigned));
+    final signature = multiBaseToUint8List(proof['proofValue'] as String);
+    expect(await wallet.holderKey().verify(signingInput, signature), isTrue);
+
+    unsigned['nonce'] = 'another-nonce';
+    expect(
+      await wallet.holderKey().verify(
+        utf8.encode(JcsUtil.canonicalize(unsigned)),
+        signature,
+      ),
+      isFalse,
+    );
+  });
+
+  test('discloses nothing when the query names no claims', () async {
+    final wallet = await walletHoldingMembership();
+    final vp = await wallet.createPresentation(
+      credentialId,
+      requestFor({'id': 'membership', 'format': 'ldp_vc'}),
+    );
+    expect(vp['disclosures'], isEmpty);
+  });
+
+  test('refuses a claim the credential cannot show', () async {
+    final wallet = await walletHoldingMembership();
+    final request = requestFor({
+      'id': 'membership',
+      'format': 'ldp_vc',
+      'claims': [
+        {
+          'path': ['credentialSubject', 'tier'],
+        },
+      ],
+    });
+    await expectLater(
+      wallet.createPresentation(credentialId, request),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a claim whose value the request rules out', () async {
+    final wallet = await walletHoldingMembership();
+    final request = requestFor({
+      'id': 'membership',
+      'format': 'ldp_vc',
+      'claims': [
+        {
+          'path': ['credentialSubject', 'memberId'],
+          'values': ['M-00001'],
+        },
+      ],
+    });
+    await expectLater(
+      wallet.createPresentation(credentialId, request),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('uses the first claim set the credential can satisfy', () async {
+    final wallet = await walletHoldingMembership();
+    final request = requestFor({
+      'id': 'membership',
+      'format': 'ldp_vc',
+      'claims': [
+        {
+          'id': 'tier',
+          'path': ['credentialSubject', 'tier'],
+        },
+        {
+          'id': 'member_id',
+          'path': ['credentialSubject', 'memberId'],
+        },
+        {
+          'id': 'name',
+          'path': ['credentialSubject', 'name'],
+        },
+      ],
+      'claim_sets': [
+        ['tier'],
+        ['member_id', 'name'],
+      ],
+    });
+    final vp = await wallet.createPresentation(credentialId, request);
+    expect(
+      (vp['disclosures'] as List).map((d) => (d as Map)['name']),
+      unorderedEquals(['memberId', 'name']),
+    );
+  });
+
+  test('refuses a request for another kind of credential', () async {
+    final wallet = await walletHoldingMembership();
+    final otherFormat = requestFor({'id': 'x', 'format': 'dc+sd-jwt'});
+    final otherType = requestFor({
+      'id': 'x',
+      'format': 'ldp_vc',
+      'meta': {
+        'type_values': [
+          ['VerifiableCredential', 'DriverLicence'],
+        ],
+      },
+    });
+    for (final request in [otherFormat, otherType]) {
+      await expectLater(
+        wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    }
+  });
+
+  test('refuses a credential the wallet does not hold', () async {
+    final wallet = await walletHoldingMembership();
+    await expectLater(
+      wallet.createPresentation(
+        'urn:uuid:not-held',
+        PresentationRequest.fromJson(doorRequest()),
+      ),
+      throwsA(isA<WalletException>()),
+    );
+  });
+}
