   /// Builds a presentation of the held credential [credentialId] in answer
   /// to [request], ready to send to the requester.
+  ///
+  /// The presentation carries the credential exactly as issued plus the
+  /// disclosures for the claims the request's DCQL query asks for — no
+  /// others. It is bound to the request's `nonce` and domain (`client_id`)
+  /// and signed with the holder key (`Ed25519Signature2020` over the RFC 8785
+  /// form of the presentation without its `proof`), the form the door
+  /// verifier checks.
   Future<Map<String, dynamic>> createPresentation(
     String credentialId,
     PresentationRequest request,
   ) async {
-    throw UnimplementedError('createPresentation');
+    final credential = _store.byId(credentialId);
+    if (credential == null) {
+      throw WalletException('No credential $credentialId in the wallet');
+    }
+    final key = holderKey();
+    if (credential.holderDid != key.did) {
+      throw WalletException(
+        'Credential $credentialId belongs to ${credential.holderDid}, not ${key.did}',
+      );
+    }
+    final query = _queryFor(credential, request);
+    final disclosures = _disclosuresFor(credential, query);
+
+    final presentation = <String, dynamic>{
+      '@context': [_credentialsContext],
+      'type': ['VerifiablePresentation'],
+      'holder': key.did,
+      'verifiableCredential': credential.vc,
+      'disclosures': [for (final d in disclosures) d.toJson()],
+      'nonce': request.nonce,
+      'domain': request.domain,
+    };
+    final signature = await key.sign(
+      utf8.encode(JcsUtil.canonicalize(presentation)),
+    );
+    presentation['proof'] = {
+      'type': 'Ed25519Signature2020',
+      'created': _clock().millisecondsSinceEpoch ~/ 1000,
+      'verificationMethod': key.keyId,
+      'proofPurpose': 'authentication',
+      'proofValue': toMultiBase(signature),
+    };
+    return presentation;
+  }
+
+  static const _credentialsContext = 'https://www.w3.org/2018/credentials/v1';
+
+  /// The credential query in [request] that [credential] answers.
+  DcqlCredential _queryFor(
+    HeldCredential credential,
+    PresentationRequest request,
+  ) {
+    final types = switch (credential.vc['type']) {
+      final List<dynamic> list => list.whereType<String>().toSet(),
+      final String single => {single},
+      _ => <String>{},
+    };
+    for (final query in request.dcqlQuery.credentials) {
+      if (query.format != CredentialFormat.ldpVc) continue;
+      final typeValues = query.meta?.typeValues;
+      if (typeValues != null &&
+          !typeValues.any((wanted) => types.containsAll(wanted))) {
+        continue;
+      }
+      return query;
+    }
+    throw WalletException(
+      'The request does not ask for a credential like ${credential.id}',
+    );
+  }
+
+  /// The disclosures that reveal exactly the claims [query] asks for.
+  List<Disclosure> _disclosuresFor(
+    HeldCredential credential,
+    DcqlCredential query,
+  ) {
+    final claims = query.claims;
+    if (claims == null || claims.isEmpty) return const [];
+
+    Disclosure? disclosureFor(DcqlClaim claim) {
+      final path = claim.path;
+      if (path.length != 2 || path[0] != 'credentialSubject') return null;
+      for (final disclosure in credential.disclosures) {
+        if (disclosure.name != path[1]) continue;
+        final values = claim.values;
+        if (values != null && !values.contains(disclosure.value)) return null;
+        return disclosure;
+      }
+      return null;
+    }
+
+    List<Disclosure>? satisfy(Iterable<DcqlClaim> wanted) {
+      final found = <Disclosure>[];
+      for (final claim in wanted) {
+        final disclosure = disclosureFor(claim);
+        if (disclosure == null) return null;
+        if (!found.contains(disclosure)) found.add(disclosure);
+      }
+      return found;
+    }
+
+    final claimSets = query.claimSets;
+    if (claimSets == null) {
+      final found = satisfy(claims);
+      if (found != null) return found;
+      final missing = claims.where((c) => disclosureFor(c) == null);
+      throw WalletException(
+        'Credential ${credential.id} cannot show ${missing.map((c) => c.path.join('.')).join(', ')}',
+      );
+    }
+    // Claim sets are alternatives in order of the verifier's preference.
+    for (final set in claimSets) {
+      final wanted = [
+        for (final id in set) ...claims.where((claim) => claim.id == id),
+      ];
+      final found = wanted.length == set.length ? satisfy(wanted) : null;
+      if (found != null) return found;
+    }
+    throw WalletException(
+      'Credential ${credential.id} satisfies none of the requested claim sets',
+    );
   }
 }
