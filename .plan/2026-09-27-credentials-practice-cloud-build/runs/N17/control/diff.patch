+
+// Ticket #4127: issuers republish their did:web documents (key rotation), so the
+// verifier must check against the document served now, not the onboarding copy.
+
+const CEDAR_DID: &str = "did:web:issuer.cedarrowing.example";
+const CEDAR_URL: &str = "https://issuer.cedarrowing.example/.well-known/did.json";
+
+fn single_key_document(did: &str, key_id: &str, key: &ed25519_dalek::VerifyingKey) -> serde_json::Value {
+    let multibase = credentials_backend::resolver::did_key_for(key).trim_start_matches("did:key:").to_string();
+    json!({
+        "@context": ["https://www.w3.org/ns/did/v1", "https://w3id.org/security/multikey/v1"],
+        "id": did,
+        "verificationMethod": [{ "id": key_id, "type": "Multikey", "controller": did, "publicKeyMultibase": multibase }],
+        "authentication": [key_id],
+        "assertionMethod": [key_id],
+    })
+}
+
+fn verifier_with(store: std::sync::Arc<credentials_backend::store::Store>, url: &str, document: serde_json::Value) -> credentials_backend::verifier::Verifier {
+    let transport = transport().with(url, document.to_string());
+    let resolver = credentials_backend::resolver::Resolver::new(std::sync::Arc::new(transport));
+    credentials_backend::verifier::Verifier::new(resolver, store).with_clock(|| NOW)
+}
+
+#[test]
+fn a_credential_signed_with_a_rotated_key_verifies_against_the_published_document() {
+    // The onboarding data still lists Cedar's key-1; Cedar now publishes key-2.
+    let store = store();
+    let onboarded = store.onboarded_issuer(CEDAR_DID).unwrap();
+    assert!(onboarded.document.verification_method.iter().all(|vm| !vm.id.as_str().ends_with("#key-2")));
+
+    let cedar = credentials_backend::issuer::Issuer::new(CEDAR_DID, &format!("{CEDAR_DID}#key-2"), &[42; 32]);
+    let published = single_key_document(CEDAR_DID, &format!("{CEDAR_DID}#key-2"), &cedar.verifying_key());
+    let holder = Holder::new(1);
+    let issued = cedar.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let verified = verifier_with(store, CEDAR_URL, published).verify_presentation(&submission("req-1", vp), NONCE, DOMAIN).unwrap();
+    assert_eq!(verified.credential.issuer, CEDAR_DID);
+}
+
+#[test]
+fn a_key_the_issuer_no_longer_publishes_is_rejected() {
+    let store = store();
+    let retired = credentials_backend::issuer::Issuer::new(CEDAR_DID, &format!("{CEDAR_DID}#key-1"), &[41; 32]);
+    let current = ed25519_dalek::SigningKey::from_bytes(&[42; 32]).verifying_key();
+    // The onboarding record lists the retired key; the published document does not.
+    store.record_onboarded_issuer(credentials_backend::store::OnboardedIssuer {
+        did: CEDAR_DID.into(),
+        name: "Cedar Rowing Association".into(),
+        onboarded_at: "2025-05-02".into(),
+        document: serde_json::from_value(single_key_document(CEDAR_DID, &format!("{CEDAR_DID}#key-1"), &retired.verifying_key())).unwrap(),
+    });
+    let holder = Holder::new(1);
+    let issued = retired.issue(&store, &membership_request(&holder)).unwrap();
+
+    let published = single_key_document(CEDAR_DID, &format!("{CEDAR_DID}#key-2"), &current);
+    let err = verifier_with(store, CEDAR_URL, published).verify_credential(&issued.credential).unwrap_err();
+    assert!(matches!(err, VerifyError::UnknownKey(_)), "{err:?}");
+}
+
+#[test]
+fn every_onboarded_issuer_resolves_to_its_published_document() {
+    use credentials_backend::resolver::Resolver;
+    use credentials_backend::transport::MirrorTransport;
+    let store = store();
+    let verifier = credentials_backend::verifier::Verifier::new(Resolver::new(std::sync::Arc::new(MirrorTransport::from_env())), store.clone());
+    for issuer in store.onboarded_issuers() {
+        let document = verifier.resolve_issuer(&issuer.did).unwrap_or_else(|e| panic!("{}: {e}", issuer.did));
+        assert_eq!(document.id.as_str(), issuer.did);
+        assert!(!document.assertion_method.is_empty(), "{}", issuer.did);
+    }
+}
+
+#[test]
+fn a_credential_whose_proof_type_is_not_checked_is_rejected() {
+    let store = store();
+    let holder = Holder::new(1);
+    let mut issued = harbour().issue(&store, &membership_request(&holder)).unwrap();
+    issued.credential["expires_at"] = json!(NOW + 3650 * DAY);
+    issued.credential["proof"]["type"] = json!("DataIntegrityProof");
+    let err = verifier(store).verify_credential(&issued.credential).unwrap_err();
+    assert!(matches!(err, VerifyError::BadSignature(_)), "{err:?}");
+}
