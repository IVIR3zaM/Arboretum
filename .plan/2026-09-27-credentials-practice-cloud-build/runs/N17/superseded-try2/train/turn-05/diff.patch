diff --git a/backend/tests/callbacks.rs b/backend/tests/callbacks.rs
new file mode 100644
index 0000000..8b42253
--- /dev/null
+++ b/backend/tests/callbacks.rs
@@ -0,0 +1,177 @@
+//! TICKET-2 reproduction: revocation callbacks must reach every subscriber of
+//! the revoking tenant, whatever the size of the tenant's settings and however
+//! one subscriber's endpoint behaves, and a green health check must mean
+//! callbacks are reaching subscribers.
+//!
+//! Time is paused: the notifier's `DISPATCH_BUDGET` stands in for the
+//! function's hard `timeout_seconds: 10` (reference/infra/webhook-config.yaml),
+//! and `SettingsStore` charges its per-page read latency.
+use std::sync::Arc;
+use std::time::Duration;
+
+use credentials_backend::notifier::{MemorySink, Notifier, WEBHOOK_KIND};
+use credentials_backend::settings::{Setting, SettingsStore};
+use credentials_backend::status::StatusChange;
+use credentials_backend::webhook::{Endpoint, HermeticTransport};
+use serde_json::json;
+
+const LEAGUE: &str = "did:web:badges.kestrel-league.example";
+
+/// Settings a large account carries besides its webhooks: 250 pages of 100.
+const LARGE_ACCOUNT_SETTINGS: usize = 25_000;
+
+struct Rig {
+    settings: Arc<SettingsStore>,
+    transport: Arc<HermeticTransport>,
+    notifier: Notifier,
+}
+
+fn rig() -> Rig {
+    let settings = Arc::new(SettingsStore::new());
+    let transport = Arc::new(HermeticTransport::new());
+    let notifier = Notifier::new(settings.clone(), transport.clone(), Arc::new(MemorySink::default()));
+    Rig { settings, transport, notifier }
+}
+
+impl Rig {
+    fn with_other_settings(self, count: usize) -> Self {
+        for i in 0..count {
+            self.settings.put(Setting::new(LEAGUE, &format!("pref/{i:06}"), "preference", json!({ "n": i })));
+        }
+        self
+    }
+
+    /// Subscribes `id` at a URL answered as `endpoint`; returns the URL.
+    fn subscriber(&self, id: &str, endpoint: Endpoint) -> String {
+        let url = format!("https://{id}.rp.example/hooks/status");
+        self.settings.put(Setting::new(LEAGUE, &format!("webhook/{id}"), WEBHOOK_KIND, json!({ "url": url })));
+        self.transport.route(&url, endpoint);
+        url
+    }
+
+    async fn revoke(&self) {
+        self.notifier
+            .notify(&StatusChange {
+                credential_id: "urn:uuid:00000000-0000-4000-8000-000000000001".into(),
+                issuer: LEAGUE.into(),
+                status_list: format!("{LEAGUE}#revocation"),
+                status_index: 1,
+                revoked: true,
+            })
+            .await;
+    }
+
+    fn missed<'a>(&self, urls: &'a [String]) -> Vec<&'a str> {
+        urls.iter().filter(|url| self.transport.received(url).len() != 1).map(String::as_str).collect()
+    }
+}
+
+fn healthy_subscribers(rig: &Rig, count: usize) -> Vec<String> {
+    (0..count).map(|i| rig.subscriber(&format!("rp-{i:03}"), Endpoint::ok())).collect()
+}
+
+// --- an account with a lot of settings --------------------------------------
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_large_account_is_notified() {
+    let rig = rig().with_other_settings(LARGE_ACCOUNT_SETTINGS);
+    let urls = healthy_subscribers(&rig, 3);
+
+    rig.revoke().await;
+
+    assert_eq!(rig.missed(&urls), Vec::<&str>::new(), "subscribers that did not receive the revocation");
+}
+
+#[tokio::test(start_paused = true)]
+async fn the_health_check_is_not_green_while_a_large_accounts_subscribers_miss_revocations() {
+    let rig = rig().with_other_settings(LARGE_ACCOUNT_SETTINGS);
+    let urls = healthy_subscribers(&rig, 3);
+
+    rig.revoke().await;
+
+    let missed = rig.missed(&urls);
+    assert!(
+        missed.is_empty() || !rig.notifier.canary_healthy(),
+        "health check green while {} of {} subscribers missed the revocation: {missed:?}",
+        missed.len(),
+        urls.len()
+    );
+}
+
+/// Control: the same account with a fifth of the settings.
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_mid_sized_account_is_notified() {
+    let rig = rig().with_other_settings(5_000);
+    let urls = healthy_subscribers(&rig, 3);
+
+    rig.revoke().await;
+
+    assert_eq!(rig.missed(&urls), Vec::<&str>::new(), "subscribers that did not receive the revocation");
+}
+
+// --- one subscriber's endpoint misbehaving ----------------------------------
+
+#[tokio::test(start_paused = true)]
+async fn a_subscriber_that_never_answers_does_not_stop_the_others() {
+    let rig = rig();
+    rig.subscriber("a-silent", Endpoint::Hang);
+    let urls = vec![rig.subscriber("b-healthy", Endpoint::ok()), rig.subscriber("c-healthy", Endpoint::ok())];
+
+    rig.revoke().await;
+
+    assert_eq!(rig.missed(&urls), Vec::<&str>::new(), "healthy subscribers that did not receive the revocation");
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_slow_subscriber_does_not_stop_the_others() {
+    let rig = rig();
+    rig.subscriber("a-slow", Endpoint::slow(Duration::from_secs(30)));
+    let urls = vec![rig.subscriber("b-healthy", Endpoint::ok()), rig.subscriber("c-healthy", Endpoint::ok())];
+
+    rig.revoke().await;
+
+    assert_eq!(rig.missed(&urls), Vec::<&str>::new(), "healthy subscribers that did not receive the revocation");
+}
+
+#[tokio::test(start_paused = true)]
+async fn the_health_check_is_not_green_while_a_silent_subscriber_blocks_the_others() {
+    let rig = rig();
+    let silent = rig.subscriber("a-silent", Endpoint::Hang);
+    let mut urls = vec![silent];
+    urls.push(rig.subscriber("b-healthy", Endpoint::ok()));
+
+    rig.revoke().await;
+
+    let missed = rig.missed(&urls);
+    assert!(
+        missed.is_empty() || !rig.notifier.canary_healthy(),
+        "health check green while {} of {} subscribers missed the revocation: {missed:?}",
+        missed.len(),
+        urls.len()
+    );
+}
+
+/// Control: the silent subscriber sorts after the healthy ones.
+#[tokio::test(start_paused = true)]
+async fn healthy_subscribers_sorted_before_a_silent_one_are_notified() {
+    let rig = rig();
+    let urls = vec![rig.subscriber("a-healthy", Endpoint::ok()), rig.subscriber("b-healthy", Endpoint::ok())];
+    rig.subscriber("z-silent", Endpoint::Hang);
+
+    rig.revoke().await;
+
+    assert_eq!(rig.missed(&urls), Vec::<&str>::new(), "healthy subscribers that did not receive the revocation");
+}
+
+// --- an account with a lot of subscribers ----------------------------------
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_an_account_with_many_subscribers_is_notified() {
+    let rig = rig();
+    let urls = healthy_subscribers(&rig, 100);
+
+    rig.revoke().await;
+
+    let missed = rig.missed(&urls);
+    assert!(missed.is_empty(), "{} of {} subscribers did not receive the revocation", missed.len(), urls.len());
+}
diff --git a/backend/tests/published_keys.rs b/backend/tests/published_keys.rs
new file mode 100644
index 0000000..b46e442
--- /dev/null
+++ b/backend/tests/published_keys.rs
@@ -0,0 +1,261 @@
+//! TICKET-1 reproduction: the door must accept a credential signed with the
+//! key an approved issuer publishes today.
+//!
+//! The documents are the hosted copies in `reference/infra/hosted-dids/`,
+//! served through a `StaticTransport` at the URL the did:web spec maps each
+//! DID to (did-web-method.md §3.2), so the transport holds exactly what the
+//! issuer's domain serves.
+//!
+//! Only Harbour Club's private key is known to the suite. For the other
+//! issuers the door tests serve the hosted document with its published key
+//! swapped for a test key (same DID, same verification method id, same
+//! relationships and services): the situation after the issuer rotated to a
+//! key we can sign with. `the_door_checks_*_against_the_document_served_today`
+//! use the real published keys and need no signing.
+mod common;
+
+use std::sync::Arc;
+
+use credentials_backend::issuer::Issuer;
+use credentials_backend::resolver::{did_key_for, did_web_url, ResolveError, Resolver};
+use credentials_backend::store::Store;
+use credentials_backend::transport::StaticTransport;
+use credentials_backend::verifier::{VerifyError, Verifier};
+use ed25519_dalek::SigningKey;
+use serde_json::Value;
+
+use common::*;
+
+struct Published {
+    did: &'static str,
+    /// Where did-web-method.md §3.2 says the document is served.
+    url: &'static str,
+    document: &'static str,
+}
+
+const HARBOUR: Published = Published {
+    did: "did:web:members.harbourclub.example",
+    url: "https://members.harbourclub.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/members.harbourclub.example/.well-known/did.json"),
+};
+
+const CEDAR: Published = Published {
+    did: "did:web:issuer.cedarrowing.example",
+    url: "https://issuer.cedarrowing.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/issuer.cedarrowing.example/.well-known/did.json"),
+};
+
+const NORTHFIELD: Published = Published {
+    did: "did:web:guild.northfield.example:chapters:north",
+    url: "https://guild.northfield.example/chapters/north/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/guild.northfield.example/chapters/north/did.json"),
+};
+
+const KESTREL: Published = Published {
+    did: "did:web:badges.kestrel-league.example",
+    url: "https://badges.kestrel-league.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/badges.kestrel-league.example/.well-known/did.json"),
+};
+
+fn parsed(published: &Published) -> Value {
+    serde_json::from_str(published.document).unwrap()
+}
+
+/// The one verification method the hosted document lists: (id, publicKeyMultibase).
+fn published_key(document: &Value) -> (String, String) {
+    let vm = &document["verificationMethod"][0];
+    (vm["id"].as_str().unwrap().to_string(), vm["publicKeyMultibase"].as_str().unwrap().to_string())
+}
+
+fn multibase(key: &SigningKey) -> String {
+    did_key_for(&key.verifying_key()).trim_start_matches("did:key:").to_string()
+}
+
+/// A verifier over `store` whose transport serves `documents`.
+fn door(store: Arc<Store>, documents: &[(&str, String)]) -> Verifier {
+    let transport = documents.iter().fold(StaticTransport::default(), |t, (url, body)| t.with(url, body.clone()));
+    Verifier::new(Resolver::new(Arc::new(transport)), store).with_clock(|| NOW)
+}
+
+/// Serves `published` with its key replaced by `key`, then presents a
+/// credential that issuer signs with `key` at the door.
+fn present_at_door(published: &Published, key: &SigningKey) {
+    let mut document = parsed(published);
+    document["verificationMethod"][0]["publicKeyMultibase"] = Value::String(multibase(key));
+    let (key_id, _) = published_key(&document);
+
+    let store = store();
+    let verifier = door(store.clone(), &[(published.url, document.to_string())]);
+    let issuer = Issuer::new(published.did, &key_id, &key.to_bytes());
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let result = verifier.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN);
+    assert!(
+        result.is_ok(),
+        "door refused a credential {} signed with {key_id}, the key its document lists: {:?}",
+        published.did,
+        result.unwrap_err()
+    );
+}
+
+// --- the door, one test per approved issuer -------------------------------
+
+#[test]
+fn the_door_accepts_harbour_signed_with_its_published_key() {
+    let key = SigningKey::from_bytes(&seed(HARBOUR_SEED));
+    assert_eq!(multibase(&key), published_key(&parsed(&HARBOUR)).1, "HARBOUR_SEED is the published key");
+    present_at_door(&HARBOUR, &key);
+}
+
+#[test]
+fn the_door_accepts_cedar_rowing_signed_with_a_key_its_document_lists() {
+    present_at_door(&CEDAR, &SigningKey::from_bytes(&[0xC1; 32]));
+}
+
+#[test]
+fn the_door_accepts_northfield_north_signed_with_a_key_its_document_lists() {
+    present_at_door(&NORTHFIELD, &SigningKey::from_bytes(&[0xC2; 32]));
+}
+
+#[test]
+fn the_door_accepts_kestrel_signed_with_a_key_its_document_lists() {
+    present_at_door(&KESTREL, &SigningKey::from_bytes(&[0xC3; 32]));
+}
+
+/// Harbour has not rotated yet; this is the day it does.
+#[test]
+fn the_door_accepts_harbour_after_it_rotates_its_key() {
+    present_at_door(&HARBOUR, &SigningKey::from_bytes(&[0xC4; 32]));
+}
+
+// --- refusals the fix introduces on purpose --------------------------------
+
+/// Harbour signs with the key it published at onboarding; the served
+/// document is `document`. The credential must not verify.
+fn harbour_old_key_credential_against(document: Value) -> VerifyError {
+    let store = store();
+    let verifier = door(store.clone(), &[(HARBOUR.url, document.to_string())]);
+    let holder = Holder::new(1);
+    let issued = harbour().issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+    match verifier.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN) {
+        Ok(_) => panic!("door accepted a credential signed with {HARBOUR_KEY_ID}, a key Harbour no longer serves"),
+        Err(e) => e,
+    }
+}
+
+/// did-web-method.md §4: a key that no longer appears in the served document
+/// is not a key of the DID. Rotation that keeps the verification method id.
+#[test]
+fn the_door_refuses_a_key_the_issuer_replaced_under_the_same_id() {
+    let mut document = parsed(&HARBOUR);
+    document["verificationMethod"][0]["publicKeyMultibase"] = Value::String(multibase(&SigningKey::from_bytes(&[0xC5; 32])));
+    let err = harbour_old_key_credential_against(document);
+    assert!(matches!(err, VerifyError::BadSignature(_)), "{err:?}");
+}
+
+/// Rotation to a new verification method id; the old id is gone.
+#[test]
+fn the_door_refuses_a_key_id_the_issuer_no_longer_lists() {
+    let new_id = format!("{HARBOUR_DID}#key-2");
+    let mut document = parsed(&HARBOUR);
+    document["verificationMethod"][0]["id"] = Value::String(new_id.clone());
+    document["verificationMethod"][0]["publicKeyMultibase"] = Value::String(multibase(&SigningKey::from_bytes(&[0xC6; 32])));
+    document["authentication"] = serde_json::json!([new_id]);
+    document["assertionMethod"] = serde_json::json!([new_id]);
+    let err = harbour_old_key_credential_against(document);
+    assert!(matches!(err, VerifyError::UnknownKey(ref id) if id == HARBOUR_KEY_ID), "{err:?}");
+}
+
+/// Fail closed: no document served means no verification, even for an
+/// onboarded issuer signing with the key it onboarded with.
+#[test]
+fn the_door_refuses_when_the_issuer_document_cannot_be_fetched() {
+    let store = store();
+    let verifier = door(store.clone(), &[]);
+    let issued = harbour().issue(&store, &membership_request(&Holder::new(1))).unwrap();
+    let err = verifier.verify_credential(&issued.credential).expect_err("door accepted without a served document");
+    assert!(matches!(err, VerifyError::Resolve(ResolveError::Transport(_))), "{err:?}");
+}
+
+// --- the document the door checks against, with the real published keys -
+
+fn assert_checks_against_served_document(published: &Published) {
+    let served = parsed(published);
+    let verifier = door(store(), &[(published.url, published.document.to_string())]);
+    let document = verifier.resolve_issuer(published.did).unwrap_or_else(|e| panic!("{}: {e}", published.did));
+
+    let keys: Vec<(String, String)> = document
+        .verification_method
+        .iter()
+        .map(|vm| (vm.id.to_string(), vm.property_set["publicKeyMultibase"].as_str().unwrap_or_default().to_string()))
+        .collect();
+    assert_eq!(keys, vec![published_key(&served)], "{}: keys the door checks against vs keys served today", published.did);
+
+    let site = document.service.iter().find_map(|s| s.service_endpoint.get_uri());
+    assert_eq!(
+        site.as_deref(),
+        served["service"][0]["serviceEndpoint"].as_str(),
+        "{}: LinkedDomains shown to door staff vs served today",
+        published.did
+    );
+}
+
+#[test]
+fn the_door_checks_harbour_against_the_document_served_today() {
+    assert_checks_against_served_document(&HARBOUR);
+}
+
+#[test]
+fn the_door_checks_cedar_rowing_against_the_document_served_today() {
+    assert_checks_against_served_document(&CEDAR);
+}
+
+#[test]
+fn the_door_checks_northfield_north_against_the_document_served_today() {
+    assert_checks_against_served_document(&NORTHFIELD);
+}
+
+#[test]
+fn the_door_checks_kestrel_against_the_document_served_today() {
+    assert_checks_against_served_document(&KESTREL);
+}
+
+// --- did:web URL mapping: did-web-method.md §3.2 examples ------------------
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_bare_domain() {
+    assert_eq!(did_web_url("did:web:w3c-ccg.github.io").unwrap(), "https://w3c-ccg.github.io/.well-known/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_path() {
+    assert_eq!(did_web_url("did:web:w3c-ccg.github.io:user:alice").unwrap(), "https://w3c-ccg.github.io/user/alice/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_port() {
+    assert_eq!(did_web_url("did:web:example.com%3A3000").unwrap(), "https://example.com:3000/.well-known/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_port_and_a_path() {
+    assert_eq!(
+        did_web_url("did:web:example.com%3A3000:user:alice").unwrap(),
+        "https://example.com:3000/user/alice/did.json"
+    );
+}
+
+#[test]
+fn did_web_url_for_northfield_is_where_its_document_is_hosted() {
+    assert_eq!(did_web_url(NORTHFIELD.did).unwrap(), NORTHFIELD.url);
+}
+
+#[test]
+fn northfield_resolves_from_its_hosted_url() {
+    let transport = StaticTransport::default().with(NORTHFIELD.url, NORTHFIELD.document);
+    let document = Resolver::new(Arc::new(transport)).resolve(NORTHFIELD.did);
+    assert!(document.is_ok(), "{:?}", document.err().map(|e| e.to_string()));
+}
