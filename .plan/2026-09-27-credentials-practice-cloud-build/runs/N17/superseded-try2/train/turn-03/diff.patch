diff --git a/backend/tests/published_keys.rs b/backend/tests/published_keys.rs
new file mode 100644
index 0000000..f7bdc3a
--- /dev/null
+++ b/backend/tests/published_keys.rs
@@ -0,0 +1,211 @@
+//! TICKET-1 reproduction: the door must accept a credential signed with the
+//! key an approved issuer publishes today.
+//!
+//! The documents are the hosted copies in `reference/infra/hosted-dids/`,
+//! served through a `StaticTransport` at the URL the did:web spec maps each
+//! DID to (did-web-method.md §3.2), so the transport holds exactly what the
+//! issuer's domain serves.
+//!
+//! Only Harbour Club's private key is known to the suite. For the other
+//! issuers the door tests serve the hosted document with its published key
+//! swapped for a test key (same DID, same verification method id, same
+//! relationships and services): the situation after the issuer rotated to a
+//! key we can sign with. `the_door_checks_*_against_the_document_served_today`
+//! use the real published keys and need no signing.
+mod common;
+
+use std::sync::Arc;
+
+use credentials_backend::issuer::Issuer;
+use credentials_backend::resolver::{did_key_for, did_web_url, Resolver};
+use credentials_backend::store::Store;
+use credentials_backend::transport::StaticTransport;
+use credentials_backend::verifier::Verifier;
+use ed25519_dalek::SigningKey;
+use serde_json::Value;
+
+use common::*;
+
+struct Published {
+    did: &'static str,
+    /// Where did-web-method.md §3.2 says the document is served.
+    url: &'static str,
+    document: &'static str,
+}
+
+const HARBOUR: Published = Published {
+    did: "did:web:members.harbourclub.example",
+    url: "https://members.harbourclub.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/members.harbourclub.example/.well-known/did.json"),
+};
+
+const CEDAR: Published = Published {
+    did: "did:web:issuer.cedarrowing.example",
+    url: "https://issuer.cedarrowing.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/issuer.cedarrowing.example/.well-known/did.json"),
+};
+
+const NORTHFIELD: Published = Published {
+    did: "did:web:guild.northfield.example:chapters:north",
+    url: "https://guild.northfield.example/chapters/north/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/guild.northfield.example/chapters/north/did.json"),
+};
+
+const KESTREL: Published = Published {
+    did: "did:web:badges.kestrel-league.example",
+    url: "https://badges.kestrel-league.example/.well-known/did.json",
+    document: include_str!("../../reference/infra/hosted-dids/badges.kestrel-league.example/.well-known/did.json"),
+};
+
+fn parsed(published: &Published) -> Value {
+    serde_json::from_str(published.document).unwrap()
+}
+
+/// The one verification method the hosted document lists: (id, publicKeyMultibase).
+fn published_key(document: &Value) -> (String, String) {
+    let vm = &document["verificationMethod"][0];
+    (vm["id"].as_str().unwrap().to_string(), vm["publicKeyMultibase"].as_str().unwrap().to_string())
+}
+
+fn multibase(key: &SigningKey) -> String {
+    did_key_for(&key.verifying_key()).trim_start_matches("did:key:").to_string()
+}
+
+/// A verifier over `store` whose transport serves `documents`.
+fn door(store: Arc<Store>, documents: &[(&str, String)]) -> Verifier {
+    let transport = documents.iter().fold(StaticTransport::default(), |t, (url, body)| t.with(url, body.clone()));
+    Verifier::new(Resolver::new(Arc::new(transport)), store).with_clock(|| NOW)
+}
+
+/// Serves `published` with its key replaced by `key`, then presents a
+/// credential that issuer signs with `key` at the door.
+fn present_at_door(published: &Published, key: &SigningKey) {
+    let mut document = parsed(published);
+    document["verificationMethod"][0]["publicKeyMultibase"] = Value::String(multibase(key));
+    let (key_id, _) = published_key(&document);
+
+    let store = store();
+    let verifier = door(store.clone(), &[(published.url, document.to_string())]);
+    let issuer = Issuer::new(published.did, &key_id, &key.to_bytes());
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let result = verifier.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN);
+    assert!(
+        result.is_ok(),
+        "door refused a credential {} signed with {key_id}, the key its document lists: {:?}",
+        published.did,
+        result.unwrap_err()
+    );
+}
+
+// --- the door, one test per approved issuer -------------------------------
+
+#[test]
+fn the_door_accepts_harbour_signed_with_its_published_key() {
+    let key = SigningKey::from_bytes(&seed(HARBOUR_SEED));
+    assert_eq!(multibase(&key), published_key(&parsed(&HARBOUR)).1, "HARBOUR_SEED is the published key");
+    present_at_door(&HARBOUR, &key);
+}
+
+#[test]
+fn the_door_accepts_cedar_rowing_signed_with_a_key_its_document_lists() {
+    present_at_door(&CEDAR, &SigningKey::from_bytes(&[0xC1; 32]));
+}
+
+#[test]
+fn the_door_accepts_northfield_north_signed_with_a_key_its_document_lists() {
+    present_at_door(&NORTHFIELD, &SigningKey::from_bytes(&[0xC2; 32]));
+}
+
+#[test]
+fn the_door_accepts_kestrel_signed_with_a_key_its_document_lists() {
+    present_at_door(&KESTREL, &SigningKey::from_bytes(&[0xC3; 32]));
+}
+
+/// Harbour has not rotated yet; this is the day it does.
+#[test]
+fn the_door_accepts_harbour_after_it_rotates_its_key() {
+    present_at_door(&HARBOUR, &SigningKey::from_bytes(&[0xC4; 32]));
+}
+
+// --- the document the door checks against, with the real published keys -
+
+fn assert_checks_against_served_document(published: &Published) {
+    let served = parsed(published);
+    let verifier = door(store(), &[(published.url, published.document.to_string())]);
+    let document = verifier.resolve_issuer(published.did).unwrap_or_else(|e| panic!("{}: {e}", published.did));
+
+    let keys: Vec<(String, String)> = document
+        .verification_method
+        .iter()
+        .map(|vm| (vm.id.to_string(), vm.property_set["publicKeyMultibase"].as_str().unwrap_or_default().to_string()))
+        .collect();
+    assert_eq!(keys, vec![published_key(&served)], "{}: keys the door checks against vs keys served today", published.did);
+
+    let site = document.service.iter().find_map(|s| s.service_endpoint.get_uri());
+    assert_eq!(
+        site.as_deref(),
+        served["service"][0]["serviceEndpoint"].as_str(),
+        "{}: LinkedDomains shown to door staff vs served today",
+        published.did
+    );
+}
+
+#[test]
+fn the_door_checks_harbour_against_the_document_served_today() {
+    assert_checks_against_served_document(&HARBOUR);
+}
+
+#[test]
+fn the_door_checks_cedar_rowing_against_the_document_served_today() {
+    assert_checks_against_served_document(&CEDAR);
+}
+
+#[test]
+fn the_door_checks_northfield_north_against_the_document_served_today() {
+    assert_checks_against_served_document(&NORTHFIELD);
+}
+
+#[test]
+fn the_door_checks_kestrel_against_the_document_served_today() {
+    assert_checks_against_served_document(&KESTREL);
+}
+
+// --- did:web URL mapping: did-web-method.md §3.2 examples ------------------
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_bare_domain() {
+    assert_eq!(did_web_url("did:web:w3c-ccg.github.io").unwrap(), "https://w3c-ccg.github.io/.well-known/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_path() {
+    assert_eq!(did_web_url("did:web:w3c-ccg.github.io:user:alice").unwrap(), "https://w3c-ccg.github.io/user/alice/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_port() {
+    assert_eq!(did_web_url("did:web:example.com%3A3000").unwrap(), "https://example.com:3000/.well-known/did.json");
+}
+
+#[test]
+fn did_web_url_matches_the_spec_example_for_a_port_and_a_path() {
+    assert_eq!(
+        did_web_url("did:web:example.com%3A3000:user:alice").unwrap(),
+        "https://example.com:3000/user/alice/did.json"
+    );
+}
+
+#[test]
+fn did_web_url_for_northfield_is_where_its_document_is_hosted() {
+    assert_eq!(did_web_url(NORTHFIELD.did).unwrap(), NORTHFIELD.url);
+}
+
+#[test]
+fn northfield_resolves_from_its_hosted_url() {
+    let transport = StaticTransport::default().with(NORTHFIELD.url, NORTHFIELD.document);
+    let document = Resolver::new(Arc::new(transport)).resolve(NORTHFIELD.did);
+    assert!(document.is_ok(), "{:?}", document.err().map(|e| e.to_string()));
+}
