+  /// The disclosures of [credential] that [query] names: a claim path
+  /// `credentialSubject.<name>` is the disclosure called `<name>`. Any other
+  /// claim path, or a query for more than one credential, is refused rather
+  /// than guessed at.
+  List<Disclosure> _requested(
+    HeldCredential credential,
+    DcqlCredentialQuery query,
+  ) {
+    if (query.credentials.length != 1) {
+      throw const WalletException(
+        'Only a query for one credential is supported',
+      );
+    }
+    final names = <String>{};
+    for (final claim
+        in query.credentials.single.claims ?? const <DcqlClaim>[]) {
+      final path = claim.path;
+      if (path.length != 2 ||
+          path[0] != 'credentialSubject' ||
+          path[1] is! String) {
+        throw WalletException('Unsupported claim request $path');
+      }
+      names.add(path[1] as String);
+    }
+    return [
+      for (final name in names)
+        credential.disclosures.firstWhere(
+          (disclosure) => disclosure.name == name,
+          orElse: () => throw WalletException(
+            'Credential ${credential.id} has no claim $name',
+          ),
+        ),
+    ];
   }
 }
diff --git a/app/test/create_presentation_test.dart b/app/test/create_presentation_test.dart
new file mode 100644
index 0000000..a3dbec9
--- /dev/null
+++ b/app/test/create_presentation_test.dart
@@ -0,0 +1,256 @@
+import 'dart:convert';
+
+import 'package:credentials_app/credentials_app.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ssi/ssi.dart';
+
+import 'fake_issuer_client.dart';
+import 'fixtures.dart';
+
+/// 2026-06-01T00:00:00Z, the backend suite's "now".
+const now = 1780272000;
+
+/// The `proofValue` the backend's own signer (`credential::sign`) produces for
+/// the presentation of [harbourIssuance] that answers [doorRequest]: holder
+/// key [holderSeed], disclosure `member` only. Ed25519 is deterministic, so
+/// the wallet must produce exactly this.
+const backendProofValue =
+    'z2AF4V6syKnxTFCRMcN5pgKfTDQ8rUK7Nxb4RKjuKwiRwK1XAik2GtX9qk36PhEJE4AxkCW2bqinbxeeXjSvNkrtj';
+
+final credentialId =
+    (harbourIssuance()['credential'] as Map<String, dynamic>)['id'] as String;
+
+CredentialStore holdingStore({HolderKey? key}) => CredentialStore()
+  ..holderKey = key ?? HolderKey.fromSeed(holderSeed)
+  ..save(HeldCredential.fromIssuance(harbourIssuance()));
+
+WalletService wallet({CredentialStore? store, int at = now}) => WalletService(
+  issuer: FakeIssuerClient(),
+  store: store ?? holdingStore(),
+  clock: () => DateTime.fromMillisecondsSinceEpoch(at * 1000, isUtc: true),
+);
+
+PresentationRequest door() => PresentationRequest.fromJson(doorRequest());
+
+/// A request from the door scanner with [dcqlQuery].
+PresentationRequest request(
+  Map<String, dynamic> dcqlQuery, {
+  String nonce = 'n-8f3Kq2xWz0Lb',
+}) => PresentationRequest.fromJson({
+  'client_id': 'door-scanner.members.test',
+  'nonce': nonce,
+  'dcql_query': dcqlQuery,
+});
+
+/// A DCQL query for one `ldp_vc` credential naming the claims at [paths].
+Map<String, dynamic> query(List<List<Object>>? paths) => {
+  'credentials': [
+    {
+      'id': 'membership',
+      'format': 'ldp_vc',
+      if (paths != null)
+        'claims': [
+          for (final path in paths) {'path': path},
+        ],
+    },
+  ],
+};
+
+Map<String, dynamic> issuedDisclosure(String name) =>
+    (harbourIssuance()['disclosures'] as List)
+        .cast<Map<String, dynamic>>()
+        .singleWhere((d) => d['name'] == name);
+
+/// Whether [vp]'s proof verifies with the holder key over the RFC 8785 form
+/// of [vp] without its proof.
+Future<bool> holderSignatureVerifies(Map<String, dynamic> vp) {
+  final unsigned = Map<String, dynamic>.of(vp)..remove('proof');
+  final signature = multiBaseToUint8List(
+    (vp['proof'] as Map)['proofValue'] as String,
+  );
+  return HolderKey.fromSeed(holderSeed)
+      .verify(utf8.encode(JcsUtil.canonicalize(unsigned)), signature);
+}
+
+void main() {
+  group('the presentation', () {
+    test('is signed exactly as the backend signs it', () async {
+      final vp = await wallet().createPresentation(credentialId, door());
+      expect((vp['proof'] as Map)['proofValue'], backendProofValue);
+    });
+
+    test('discloses only the claims the request names', () async {
+      final vp = await wallet().createPresentation(credentialId, door());
+      expect(vp['disclosures'], [issuedDisclosure('member')]);
+      final text = jsonEncode(vp);
+      for (final withheld in ['Ada Park', 'M-20417', '1990-04-12']) {
+        expect(text, isNot(contains(withheld)));
+      }
+    });
+
+    test('carries each requested disclosure exactly as issued', () async {
+      final vp = await wallet().createPresentation(
+        credentialId,
+        request(
+          query([
+            ['credentialSubject', 'member'],
+            ['credentialSubject', 'name'],
+          ]),
+        ),
+      );
+      expect(
+        vp['disclosures'],
+        unorderedEquals([issuedDisclosure('member'), issuedDisclosure('name')]),
+      );
+    });
+
+    test('carries the credential exactly as issued', () async {
+      final vp = await wallet().createPresentation(credentialId, door());
+      expect(vp['verifiableCredential'], harbourIssuance()['credential']);
+    });
+
+    test(
+      'is bound to the request nonce and client_id inside the signed part',
+      () async {
+        final vp = await wallet().createPresentation(
+          credentialId,
+          request(query(null), nonce: 'n-another'),
+        );
+        expect(vp['nonce'], 'n-another');
+        expect(vp['domain'], 'door-scanner.members.test');
+        expect(vp['holder'], holderDid);
+        expect(await holderSignatureVerifies(vp), isTrue);
+        expect(
+          await holderSignatureVerifies({...vp, 'nonce': 'n-8f3Kq2xWz0Lb'}),
+          isFalse,
+        );
+        expect(
+          await holderSignatureVerifies({...vp, 'domain': 'elsewhere.test'}),
+          isFalse,
+        );
+      },
+    );
+
+    test('is signed by the holder key for authentication', () async {
+      final vp = await wallet().createPresentation(credentialId, door());
+      final proof = vp['proof'] as Map;
+      expect(proof['type'], 'Ed25519Signature2020');
+      expect(proof['verificationMethod'], HolderKey.fromSeed(holderSeed).keyId);
+      expect(proof['proofPurpose'], 'authentication');
+    });
+
+    test('discloses nothing when the request names no claims', () async {
+      final vp = await wallet().createPresentation(
+        credentialId,
+        request(query(null)),
+      );
+      expect(vp['disclosures'], isEmpty);
+    });
+  });
+
+  group('expiry', () {
+    test('a credential is presented up to its expires_at', () async {
+      final vp = await wallet(at: harbourExpiresAt)
+          .createPresentation(credentialId, door());
+      expect(vp['verifiableCredential'], isNotNull);
+    });
+
+    test('an expired credential is refused', () async {
+      await expectLater(
+        wallet(at: harbourExpiresAt + 1)
+            .createPresentation(credentialId, door()),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('a credential without an integer expires_at is refused', () async {
+      final issuance = harbourIssuance();
+      (issuance['credential'] as Map).remove('expires_at');
+      final store = CredentialStore()
+        ..holderKey = HolderKey.fromSeed(holderSeed)
+        ..save(HeldCredential.fromIssuance(issuance));
+      await expectLater(
+        wallet(store: store).createPresentation(credentialId, door()),
+        throwsA(isA<TypeError>()),
+      );
+    });
+  });
+
+  test(
+    'the credential is kept and can be presented to a fresh request',
+    () async {
+      final store = holdingStore();
+      final w = wallet(store: store);
+      final first = await w.createPresentation(
+        credentialId,
+        request(query(null), nonce: 'n-1'),
+      );
+      final second = await w.createPresentation(
+        credentialId,
+        request(query(null), nonce: 'n-2'),
+      );
+      expect(first['nonce'], 'n-1');
+      expect(second['nonce'], 'n-2');
+      expect(store.byId(credentialId), isNotNull);
+      expect(w.heldCredentials(), hasLength(1));
+    },
+  );
+
+  group('refuses rather than guesses', () {
+    final refused = <String, Map<String, dynamic>>{
+      'a deeper claim path': query([
+        ['credentialSubject', 'club', 'member'],
+      ]),
+      'a claim outside credentialSubject': query([
+        ['evidence', 'member'],
+      ]),
+      'a claim the credential does not hold': query([
+        ['credentialSubject', 'tier'],
+      ]),
+      'a query for several credentials': {
+        'credentials': [
+          {'id': 'membership', 'format': 'ldp_vc'},
+          {'id': 'other', 'format': 'ldp_vc'},
+        ],
+      },
+    };
+    for (final MapEntry(key: name, value: dcql) in refused.entries) {
+      test(name, () async {
+        await expectLater(
+          wallet().createPresentation(credentialId, request(dcql)),
+          throwsA(isA<WalletException>()),
+        );
+      });
+    }
+  });
+
+  group('holder', () {
+    test('an unknown credential is refused', () async {
+      await expectLater(
+        wallet().createPresentation('urn:uuid:unknown', door()),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test(
+      'without a holder key, one is created and the credential is refused',
+      () async {
+        final store = CredentialStore()
+          ..save(HeldCredential.fromIssuance(harbourIssuance()));
+        await expectLater(
+          wallet(store: store).createPresentation(credentialId, door()),
+          throwsA(isA<WalletException>()),
+        );
+        expect(store.holderKey, isNotNull);
+      },
+    );
+
+    test('a credential issued to another key is refused', () async {
+      final store = holdingStore(key: HolderKey.generate());
+      await expectLater(
+        wallet(store: store).createPresentation(credentialId, door()),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
+}
