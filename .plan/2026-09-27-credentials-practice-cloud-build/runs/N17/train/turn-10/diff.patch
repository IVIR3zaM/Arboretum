-        self.sink.record(DeliveryEvent { tenant: tenant.to_string(), subscription: sub.id.clone(), outcome });
-        delivered
-    }
+/// POSTs `body` to `sub` unless `deadline` has passed, waits for the answer no
+/// longer than `deadline`, and reports the outcome; `true` if delivered.
+async fn dispatch(
+    transport: &dyn WebhookTransport,
+    sink: &dyn DeliverySink,
+    tenant: &str,
+    sub: &Subscription,
+    body: &[u8],
+    deadline: Instant,
+) -> bool {
+    let answer = match Instant::now() < deadline {
+        true => tokio::time::timeout_at(deadline, transport.post(&sub.url, body)).await.ok(),
+        false => None,
+    };
+    let outcome = match answer {
+        Some(Ok(status)) if (200..300).contains(&status) => Outcome::Delivered { status },
+        Some(Ok(status)) => Outcome::Failed { reason: format!("HTTP {status}") },
+        Some(Err(error)) => Outcome::Failed { reason: error.to_string() },
+        None => Outcome::Failed { reason: format!("no answer within {DELIVERY_DEADLINE:?} of the change") },
+    };
+    let delivered = matches!(outcome, Outcome::Delivered { .. });
+    sink.record(DeliveryEvent { tenant: tenant.to_string(), subscription: sub.id.clone(), outcome });
+    delivered
 }
