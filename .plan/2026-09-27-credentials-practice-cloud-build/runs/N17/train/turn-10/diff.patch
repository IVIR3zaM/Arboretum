diff --git a/backend/tests/ticket_4127.rs b/backend/tests/ticket_4127.rs
new file mode 100644
index 0000000..acb652d
--- /dev/null
+++ b/backend/tests/ticket_4127.rs
@@ -0,0 +1,224 @@
+//! TICKET-1 (support #4127): members of approved clubs are refused at the door.
+//!
+//! A `did:web` issuer's keys are whatever its domain serves now
+//! (`reference/did-web-method.md` §3.3, §4). These tests take each approved
+//! issuer's currently published document from `reference/infra/hosted-dids/`
+//! — the copy of the document bucket — and check the door against it.
+//!
+//! The repository holds a private key for Harbour Club only. For the other
+//! clubs, the member-path test publishes a copy of the club's current document
+//! (same DID, key id, path and services) with the key bytes replaced by a test
+//! key, so a credential can be signed with "the key the club publishes".
+
+mod common;
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use credentials_backend::issuer::Issuer;
+use credentials_backend::resolver::{did_key_for, did_web_url, Resolver};
+use credentials_backend::transport::MirrorTransport;
+use credentials_backend::verifier::{Verifier, VerifyError};
+use ed25519_dalek::SigningKey;
+use serde_json::Value;
+
+use common::*;
+
+/// Every issuer approved to issue `MembershipCredential`
+/// (`reference/trust-registry.md`, "Current records", export 2026-09-01).
+const APPROVED_ISSUERS: [&str; 4] = [
+    "did:web:members.harbourclub.example",
+    "did:web:issuer.cedarrowing.example",
+    "did:web:guild.northfield.example:chapters:north",
+    "did:web:badges.kestrel-league.example",
+];
+
+fn hosted_dids_root() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../reference/infra/hosted-dids")
+}
+
+/// The bucket object key a `did:web` document is published under
+/// (`reference/infra/did-hosting.md`): `<host>/.well-known/did.json` for a bare
+/// host, `<host>/<p1>/<p2>/did.json` for a DID with a path.
+fn object_key(did: &str) -> String {
+    let mut segments = did.strip_prefix("did:web:").unwrap().split(':');
+    let host = segments.next().unwrap().replace("%3A", ":");
+    let path: Vec<&str> = segments.collect();
+    if path.is_empty() {
+        format!("{host}/.well-known/did.json")
+    } else {
+        format!("{host}/{}/did.json", path.join("/"))
+    }
+}
+
+/// The document the club's domain serves now.
+fn published_document(did: &str) -> Value {
+    let path = hosted_dids_root().join(object_key(did));
+    let body = std::fs::read(&path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    serde_json::from_slice(&body).unwrap()
+}
+
+/// `(verification method id, publicKeyMultibase)` of the first `assertionMethod` key in `doc`.
+fn published_assertion_key(doc: &Value) -> (String, String) {
+    let id = doc["assertionMethod"][0].as_str().unwrap().to_string();
+    let vm = doc["verificationMethod"].as_array().unwrap().iter().find(|vm| vm["id"] == id.as_str()).unwrap();
+    (id, vm["publicKeyMultibase"].as_str().unwrap().to_string())
+}
+
+/// A scratch copy of the document bucket, removed on drop.
+struct Bucket {
+    root: PathBuf,
+}
+
+impl Bucket {
+    fn new(name: &str) -> Self {
+        let root = std::env::temp_dir().join(format!("ticket-4127-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        Bucket { root }
+    }
+
+    fn publish(&self, did: &str, doc: &Value) {
+        let path = self.root.join(object_key(did));
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, serde_json::to_vec_pretty(doc).unwrap()).unwrap();
+    }
+}
+
+impl Drop for Bucket {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+/// The member's path, for every approved club: the club signs a membership
+/// credential with the key it publishes now, the member presents it at the
+/// door, and the door must accept it.
+#[test]
+fn every_approved_club_s_members_are_admitted_with_a_credential_signed_by_its_current_key() {
+    let bucket = Bucket::new("door");
+    let mut refused = Vec::new();
+
+    for (i, did) in APPROVED_ISSUERS.iter().enumerate() {
+        let mut doc = published_document(did);
+        let (key_id, published_key) = published_assertion_key(&doc);
+
+        let seed = if *did == HARBOUR_DID {
+            // Harbour's real key: its published document is used unchanged.
+            seed(HARBOUR_SEED)
+        } else {
+            // Same document, key bytes replaced by a key this test can sign with.
+            let seed = [0xA0 + i as u8; 32];
+            let test_key = did_key_for(&SigningKey::from_bytes(&seed).verifying_key());
+            let test_key = test_key.trim_start_matches("did:key:").to_string();
+            for vm in doc["verificationMethod"].as_array_mut().unwrap() {
+                if vm["publicKeyMultibase"] == published_key.as_str() {
+                    vm["publicKeyMultibase"] = Value::String(test_key.clone());
+                }
+            }
+            seed
+        };
+        bucket.publish(did, &doc);
+
+        let store = store();
+        let club = Issuer::new(did, &key_id, &seed);
+        let holder = Holder::new(1);
+        let issued = club.issue(&store, &membership_request(&holder)).unwrap();
+        let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+        let door = Verifier::new(Resolver::new(Arc::new(MirrorTransport::new(&bucket.root))), store).with_clock(|| NOW);
+        match door.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN) {
+            Ok(verified) => assert_eq!(verified.credential.issuer, *did),
+            Err(e) => refused.push(format!("{did} (signed with {key_id}): {e}")),
+        }
+    }
+
+    assert!(refused.is_empty(), "members refused at the door:\n  {}", refused.join("\n  "));
+}
+
+/// Unmodified published data: the key the door checks a club's credentials
+/// against must be the key the club's domain serves now.
+#[test]
+fn the_door_checks_each_approved_club_against_the_key_it_publishes_now() {
+    let door = Verifier::new(Resolver::new(Arc::new(MirrorTransport::new(hosted_dids_root()))), store());
+    let mut mismatched = Vec::new();
+
+    for did in APPROVED_ISSUERS {
+        let (published_id, published_key) = published_assertion_key(&published_document(did));
+        let checked = match door.resolve_issuer(did) {
+            Ok(doc) => doc
+                .verification_method
+                .iter()
+                .map(|vm| format!("{} {}", vm.id, vm.property_set["publicKeyMultibase"].as_str().unwrap_or("?")))
+                .collect::<Vec<_>>()
+                .join(", "),
+            Err(e) => format!("error: {e}"),
+        };
+        let expected = format!("{published_id} {published_key}");
+        if checked != expected {
+            mismatched.push(format!("{did}\n      publishes: {expected}\n      door uses: {checked}"));
+        }
+    }
+
+    assert!(mismatched.is_empty(), "door is not using the published key:\n  {}", mismatched.join("\n  "));
+}
+
+/// A club rotates after its members have been through the door: the next
+/// check uses the new key, and a credential signed with the retired key is
+/// refused (`reference/did-web-method.md` §4: a key no longer in the served
+/// document is not a key of the DID).
+#[test]
+fn a_rotation_takes_effect_at_the_next_door_check() {
+    let bucket = Bucket::new("rotation");
+    let did = HARBOUR_DID;
+    let mut doc = published_document(did);
+    bucket.publish(did, &doc);
+
+    let store = store();
+    let door = Verifier::new(Resolver::new(Arc::new(MirrorTransport::new(&bucket.root))), store.clone()).with_clock(|| NOW);
+    let holder = Holder::new(1);
+    let old_club = harbour();
+    let old = old_club.issue(&store, &membership_request(&holder)).unwrap();
+    door.verify_presentation(&submission("req-1", holder.present(&old, &["member"], NONCE, DOMAIN)), NONCE, DOMAIN)
+        .expect("admitted before the rotation");
+
+    // The club retires key-1 and publishes key-2.
+    let new_seed = [0xB7; 32];
+    let new_id = format!("{did}#key-2");
+    let new_key = did_key_for(&SigningKey::from_bytes(&new_seed).verifying_key()).trim_start_matches("did:key:").to_string();
+    doc["verificationMethod"][0]["id"] = Value::String(new_id.clone());
+    doc["verificationMethod"][0]["publicKeyMultibase"] = Value::String(new_key);
+    doc["authentication"][0] = Value::String(new_id.clone());
+    doc["assertionMethod"][0] = Value::String(new_id.clone());
+    bucket.publish(did, &doc);
+
+    let new = Issuer::new(did, &new_id, &new_seed).issue(&store, &membership_request(&holder)).unwrap();
+    door.verify_presentation(&submission("req-2", holder.present(&new, &["member"], NONCE, DOMAIN)), NONCE, DOMAIN)
+        .expect("a credential signed with the new key is admitted");
+    let err = door
+        .verify_presentation(&submission("req-3", holder.present(&old, &["member"], NONCE, DOMAIN)), NONCE, DOMAIN)
+        .unwrap_err();
+    assert!(matches!(err, VerifyError::UnknownKey(ref id) if id == HARBOUR_KEY_ID), "{err:?}");
+}
+
+/// `did:web` with a path: no `/.well-known` (`reference/did-web-method.md` §3.2
+/// step 4 and its examples; `reference/infra/did-hosting.md`).
+#[test]
+fn did_web_with_a_path_maps_to_the_path_without_well_known() {
+    assert_eq!(
+        did_web_url("did:web:w3c-ccg.github.io:user:alice").unwrap(),
+        "https://w3c-ccg.github.io/user/alice/did.json"
+    );
+    assert_eq!(
+        did_web_url("did:web:guild.northfield.example:chapters:north").unwrap(),
+        "https://guild.northfield.example/chapters/north/did.json"
+    );
+}
+
+/// Every approved club's published document resolves from the bucket copy.
+#[test]
+fn every_approved_club_s_published_document_resolves() {
+    let resolver = Resolver::new(Arc::new(MirrorTransport::new(hosted_dids_root())));
+    let failed: Vec<String> =
+        APPROVED_ISSUERS.iter().filter_map(|did| resolver.resolve(did).err().map(|e| format!("{did}: {e}"))).collect();
+    assert!(failed.is_empty(), "published documents that do not resolve:\n  {}", failed.join("\n  "));
+}
diff --git a/backend/tests/ticket_4163.rs b/backend/tests/ticket_4163.rs
new file mode 100644
index 0000000..4bab695
--- /dev/null
+++ b/backend/tests/ticket_4163.rs
@@ -0,0 +1,239 @@
+//! TICKET-2 (support #4163): revocation callbacks never arrive for a customer
+//! with a lot of settings, while the webhook health check stays green.
+//!
+//! What support has confirmed: when a customer revokes a credential, every
+//! relying party subscribed to that customer's status changes is told,
+//! whatever the size of the customer's account and however any one relying
+//! party's endpoint is behaving; and a green health check means callbacks are
+//! reaching customers.
+//!
+//! Time is paused, so every page read (`settings::PAGE_READ_LATENCY`) and
+//! endpoint round trip (`Endpoint::TYPICAL_LATENCY`) costs what it would in
+//! production without the test waiting for it.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use credentials_backend::notifier::{MemorySink, Notifier, ALL_SUBSCRIPTIONS, CANARY_URL, WEBHOOK_KIND};
+use credentials_backend::settings::{Setting, SettingsStore};
+use credentials_backend::status::StatusChange;
+use credentials_backend::webhook::{Endpoint, HermeticTransport};
+use serde_json::json;
+
+/// The newly onboarded league from the ticket.
+const LEAGUE: &str = "did:web:badges.kestrel-league.example";
+
+/// Settings in the league's partition besides its webhook subscriptions: the
+/// largest account we have onboarded (`reference/infra/webhook-config.yaml`
+/// reads them 100 to a page).
+const LARGE_ACCOUNT_SETTINGS: usize = 25_000;
+
+struct Rig {
+    settings: Arc<SettingsStore>,
+    transport: Arc<HermeticTransport>,
+    sink: Arc<MemorySink>,
+    notifier: Notifier,
+}
+
+fn rig() -> Rig {
+    let settings = Arc::new(SettingsStore::new());
+    let transport = Arc::new(HermeticTransport::new());
+    let sink = Arc::new(MemorySink::default());
+    let notifier = Notifier::new(settings.clone(), transport.clone(), sink.clone());
+    Rig { settings, transport, sink, notifier }
+}
+
+impl Rig {
+    fn preferences(&self, tenant: &str, count: usize) {
+        for i in 0..count {
+            self.settings.put(Setting::new(tenant, &format!("pref/{i:06}"), "preference", json!({ "n": i })));
+        }
+    }
+
+    /// Subscribes relying party `id` to `tenant`'s changes, answering as `endpoint`.
+    fn subscribe(&self, tenant: &str, id: &str, endpoint: Endpoint) -> String {
+        let url = format!("https://{id}.relying-party.test/hooks/status");
+        self.settings.put(Setting::new(tenant, &format!("webhook/{id}"), WEBHOOK_KIND, json!({ "url": url })));
+        self.transport.route(&url, endpoint);
+        url
+    }
+
+    /// The subscriber URLs among `urls` that were not told.
+    fn not_told<'a>(&self, urls: &'a [String]) -> Vec<&'a str> {
+        urls.iter().filter(|url| self.transport.received(url).is_empty()).map(String::as_str).collect()
+    }
+}
+
+/// The deployment's hard limit (`reference/infra/webhook-config.yaml`,
+/// `timeout_seconds: 10`): the runtime terminates the invocation and work
+/// still in progress is abandoned.
+const RUNTIME_LIMIT: Duration = Duration::from_secs(10);
+
+/// Handles `change` the way production runs the notifier: one invocation,
+/// dropped at [`RUNTIME_LIMIT`]. The clock starts when `notify` is called,
+/// which is generous — the runtime's clock starts earlier.
+async fn invoke(notifier: &Notifier, change: &StatusChange) {
+    let _ = tokio::time::timeout(RUNTIME_LIMIT, notifier.notify(change)).await;
+}
+
+fn revocation(tenant: &str) -> StatusChange {
+    StatusChange {
+        credential_id: "urn:uuid:4163aaaa-0000-4000-8000-000000000001".into(),
+        issuer: tenant.into(),
+        status_list: format!("{tenant}#revocation"),
+        status_index: 42,
+        revoked: true,
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_customer_with_a_lot_of_settings_is_told() {
+    let rig = rig();
+    rig.preferences(LEAGUE, LARGE_ACCOUNT_SETTINGS);
+    let urls: Vec<String> = (1..=3).map(|i| rig.subscribe(LEAGUE, &format!("rp-{i}"), Endpoint::ok())).collect();
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    let missed = rig.not_told(&urls);
+    assert!(missed.is_empty(), "{} of {} subscribers not told: {missed:?}", missed.len(), urls.len());
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_one_of_a_customer_s_many_subscribers_is_told() {
+    let rig = rig();
+    let urls: Vec<String> = (1..=100).map(|i| rig.subscribe(LEAGUE, &format!("rp-{i:03}"), Endpoint::ok())).collect();
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    let missed = rig.not_told(&urls);
+    assert!(missed.is_empty(), "{} of {} subscribers not told, first: {:?}", missed.len(), urls.len(), missed.first());
+}
+
+#[tokio::test(start_paused = true)]
+async fn an_endpoint_that_never_answers_does_not_stop_the_others_being_told() {
+    let rig = rig();
+    rig.subscribe(LEAGUE, "rp-1-hung", Endpoint::Hang);
+    let others: Vec<String> = (2..=3).map(|i| rig.subscribe(LEAGUE, &format!("rp-{i}"), Endpoint::ok())).collect();
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    let missed = rig.not_told(&others);
+    assert!(missed.is_empty(), "healthy subscribers not told: {missed:?}");
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_slow_endpoint_does_not_stop_the_others_being_told() {
+    let rig = rig();
+    rig.subscribe(LEAGUE, "rp-1-slow", Endpoint::slow(Duration::from_secs(12)));
+    let others: Vec<String> = (2..=3).map(|i| rig.subscribe(LEAGUE, &format!("rp-{i}"), Endpoint::ok())).collect();
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    let missed = rig.not_told(&others);
+    assert!(missed.is_empty(), "healthy subscribers not told: {missed:?}");
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_s_delivery_outcome_is_reported() {
+    let rig = rig();
+    rig.preferences(LEAGUE, LARGE_ACCOUNT_SETTINGS);
+    let ids = ["rp-1", "rp-2", "rp-3"];
+    for id in ids {
+        rig.subscribe(LEAGUE, id, Endpoint::ok());
+    }
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    let reported: Vec<String> = rig.sink.events().into_iter().filter(|e| e.tenant == LEAGUE).map(|e| e.subscription).collect();
+    let unreported: Vec<&str> = ids.iter().copied().filter(|id| !reported.iter().any(|r| r == id)).collect();
+    assert!(unreported.is_empty(), "no outcome recorded for {unreported:?}; sink holds {:?}", rig.sink.events());
+}
+
+/// The canary targets an endpoint the platform operates, never a name
+/// reserved for documentation (`reference/infra/reserved-domains.md`).
+#[test]
+fn the_canary_does_not_target_a_reserved_domain() {
+    let host = url::Url::parse(CANARY_URL).unwrap().host_str().unwrap().to_string();
+    for reserved in ["example.com", "example.net", "example.org"] {
+        assert!(host != reserved && !host.ends_with(&format!(".{reserved}")), "canary targets {host} ({reserved} is reserved)");
+    }
+}
+
+/// When the delivery path cannot run for a change — here the subscriber list
+/// alone outlasts the time the invocation has — the health check is not
+/// green, and every subscriber still has a recorded outcome.
+#[tokio::test(start_paused = true)]
+async fn the_health_check_is_not_green_when_the_delivery_path_cannot_run_in_time() {
+    let rig = rig();
+    let ids: Vec<String> = (0..20_000).map(|i| format!("rp-{i:05}")).collect();
+    for id in &ids {
+        rig.subscribe(LEAGUE, id, Endpoint::ok());
+    }
+
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+
+    // A subscriber that was never read cannot be named, so its outcome is the
+    // one recorded against the whole subscriber list.
+    let reported: std::collections::HashSet<String> =
+        rig.sink.events().into_iter().filter(|e| e.tenant == LEAGUE).map(|e| e.subscription).collect();
+    let list_failed = reported.contains(ALL_SUBSCRIPTIONS);
+    let unreported = ids.iter().filter(|id| !reported.contains(*id)).count();
+    assert!(
+        !rig.notifier.canary_healthy() && (unreported == 0 || list_failed),
+        "canary_healthy() == {}, {unreported} of {} subscribers have no recorded outcome, list-level outcome recorded: {list_failed}",
+        rig.notifier.canary_healthy(),
+        ids.len()
+    );
+}
+
+/// A change the runtime cuts short must not leave the previous change's green
+/// standing, and what was not delivered must show up as a recorded outcome.
+#[tokio::test(start_paused = true)]
+async fn a_change_the_runtime_cuts_short_does_not_leave_the_health_check_green() {
+    let rig = rig();
+    rig.subscribe(LEAGUE, "rp-1", Endpoint::ok());
+    invoke(&rig.notifier, &revocation(LEAGUE)).await;
+    assert!(rig.notifier.canary_healthy(), "green after a change that was delivered");
+
+    // The next change is for a customer whose subscriber list alone outlasts the invocation.
+    const BIG: &str = "did:web:guild.northfield.example:chapters:north";
+    for i in 0..25_000 {
+        rig.subscribe(BIG, &format!("big-{i:05}"), Endpoint::ok());
+    }
+    invoke(&rig.notifier, &revocation(BIG)).await;
+
+    let recorded: Vec<_> = rig.sink.events().into_iter().filter(|e| e.tenant == BIG).collect();
+    assert!(
+        !rig.notifier.canary_healthy() && !recorded.is_empty(),
+        "after a change cut short by the runtime: canary_healthy() == {}, {} outcomes recorded for {BIG}",
+        rig.notifier.canary_healthy(),
+        recorded.len()
+    );
+}
+
+/// "A green health check means callbacks are reaching customers."
+#[tokio::test(start_paused = true)]
+async fn the_health_check_is_not_green_while_subscribers_miss_callbacks() {
+    let mut observed = Vec::new();
+
+    // The ticket's customer: a lot of settings, healthy endpoints.
+    let large = rig();
+    large.preferences(LEAGUE, LARGE_ACCOUNT_SETTINGS);
+    let urls: Vec<String> = (1..=3).map(|i| large.subscribe(LEAGUE, &format!("rp-{i}"), Endpoint::ok())).collect();
+    invoke(&large.notifier, &revocation(LEAGUE)).await;
+    observed.push(("large account", large.notifier.canary_healthy(), large.not_told(&urls).len(), urls.len()));
+
+    // A small customer with one relying party that never answers.
+    let hung = rig();
+    hung.subscribe(LEAGUE, "rp-1-hung", Endpoint::Hang);
+    let urls: Vec<String> = (2..=3).map(|i| hung.subscribe(LEAGUE, &format!("rp-{i}"), Endpoint::ok())).collect();
+    invoke(&hung.notifier, &revocation(LEAGUE)).await;
+    observed.push(("hung endpoint", hung.notifier.canary_healthy(), hung.not_told(&urls).len(), urls.len()));
+
+    let contradictions: Vec<String> = observed
+        .iter()
+        .filter(|(_, healthy, missed, _)| *healthy && *missed > 0)
+        .map(|(case, _, missed, total)| format!("{case}: canary_healthy() == true, {missed} of {total} subscribers not told"))
+        .collect();
+    assert!(contradictions.is_empty(), "health check green while callbacks are missing:\n  {}", contradictions.join("\n  "));
+}
