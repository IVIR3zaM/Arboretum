   HeldCredential? credential(String id) => _store.byId(id);
 
   /// Builds a presentation of the held credential [credentialId] in answer
-  /// to [request], ready to send to the requester.
+  /// to [request], ready to send to the requester: the credential as issued,
+  /// the disclosures the request's DCQL query names and nothing else, bound
+  /// to the request's nonce and domain and signed by the holder key
+  /// (`Ed25519Signature2020` over the RFC 8785 form without `proof`).
+  ///
+  /// The credential stays in the wallet; it can be presented again.
   Future<Map<String, dynamic>> createPresentation(
     String credentialId,
     PresentationRequest request,
   ) async {
-    throw UnimplementedError('createPresentation');
+    final credential = _store.byId(credentialId);
+    if (credential == null) {
+      throw WalletException('No credential $credentialId');
+    }
+    final key = holderKey();
+    if (credential.holderDid != key.did) {
+      throw WalletException(
+        'Credential $credentialId was issued to ${credential.holderDid}, not ${key.did}',
+      );
+    }
+    final expiresAt = credential.vc['expires_at'] as int;
+    final now = _clock().millisecondsSinceEpoch ~/ 1000;
+    if (now > expiresAt) {
+      throw WalletException('Credential $credentialId has expired');
