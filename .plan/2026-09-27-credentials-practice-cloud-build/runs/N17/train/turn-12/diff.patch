+fn admit(store: Arc<Store>, issuer: &Issuer) -> Result<VerifiedPresentation, VerifyError> {
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).expect("issuance");
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+    door(store).verify_presentation(&submission("req-1", vp), NONCE, DOMAIN)
+}
