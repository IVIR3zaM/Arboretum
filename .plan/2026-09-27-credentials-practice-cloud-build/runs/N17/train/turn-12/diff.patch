+    let hosted = json(HOSTED_HARBOUR);
+    assert_eq!(assertion_key_id(&hosted), HARBOUR_KEY_ID);
+    assert_eq!(hosted["verificationMethod"][0]["publicKeyMultibase"], HARBOUR_PUBLIC, "Harbour hosts the key we hold");
+
+    let verified = admit(store(), &harbour()).unwrap_or_else(|e| panic!("Harbour member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, HARBOUR_DID);
+}
+
+#[test]
+fn a_member_of_an_issuer_that_rotated_to_a_new_key_id_is_admitted() {
+    let store = store();
+    let current = assertion_key_id(&json(HOSTED_CEDAR));
+    assert!(!onboarded_key_ids(&store, CEDAR_DID).contains(&current), "state: Cedar rotated to {current} after onboarding");
+
+    let issuer = Issuer::new(CEDAR_DID, &current, &CEDAR_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Cedar member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, CEDAR_DID);
+}
+
+#[test]
+fn a_member_of_a_path_did_issuer_that_replaced_its_key_under_the_same_id_is_admitted() {
+    let store = store();
+    let current = assertion_key_id(&json(HOSTED_NORTH));
+    assert!(onboarded_key_ids(&store, NORTH_DID).contains(&current), "state: Northfield kept the id {current}");
+    assert_ne!(
+        onboarded_key(&store, NORTH_DID, &current),
+        json(HOSTED_NORTH)["verificationMethod"][0]["publicKeyMultibase"].as_str().unwrap(),
+        "state: Northfield hosts different key material under {current}"
+    );
+
+    let issuer = Issuer::new(NORTH_DID, &current, &NORTH_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Northfield member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, NORTH_DID);
+}
+
+#[test]
+fn a_member_of_an_issuer_that_rotated_and_moved_its_endpoint_is_admitted_with_the_current_site() {
+    let store = store();
+    let hosted = json(HOSTED_KESTREL);
+    let current = assertion_key_id(&hosted);
+    assert!(!onboarded_key_ids(&store, KESTREL_DID).contains(&current), "state: Kestrel rotated to {current}");
+    let current_site = hosted["service"][0]["serviceEndpoint"].as_str().unwrap().to_string();
+
+    let issuer = Issuer::new(KESTREL_DID, &current, &KESTREL_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Kestrel member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer_site.as_deref(), Some(current_site.as_str()), "door staff see today's site");
+}
+
+#[test]
+fn a_credential_signed_with_a_key_the_issuer_retired_is_refused() {
+    // Cedar as onboarded listed `#key-1`; today it hosts only `#key-2`. The onboarding copy's key
+    // is swapped for a test key so the test can sign as the retired key.
+    let store = store();
+    let retired = format!("{CEDAR_DID}#key-1");
+    let mut onboarded = store.onboarded_issuer(CEDAR_DID).unwrap();
+    let document = serde_json::to_value(&onboarded.document).unwrap();
+    let document = with_key(&document, &retired, &SigningKey::from_bytes(&CEDAR_RETIRED_SEED));
+    onboarded.document = serde_json::from_value(document).unwrap();
+    store.record_onboarded_issuer(onboarded);
+    assert!(json(HOSTED_CEDAR)["verificationMethod"].as_array().unwrap().iter().all(|vm| vm["id"] != retired.as_str()));
+
+    let issuer = Issuer::new(CEDAR_DID, &retired, &CEDAR_RETIRED_SEED);
+    match admit(store, &issuer) {
+        Err(VerifyError::UnknownKey(id)) => assert_eq!(id, retired),
+        other => panic!("a credential signed with retired {retired} must be refused as an unknown key, got {other:?}"),
+    }
+}
diff --git a/backend/tests/notifier_platform.rs b/backend/tests/notifier_platform.rs
new file mode 100644
index 0000000..b1c805f
--- /dev/null
+++ b/backend/tests/notifier_platform.rs
@@ -0,0 +1,276 @@
+//! TICKET-2: revocation callbacks never arrive for some customers while the health check is green.
+//!
+//! Support's promise: when a customer revokes a credential, every relying party subscribed to that
+//! customer's status changes is told, whatever the size of the account and however any one relying
+//! party's endpoint behaves; and a green health check means callbacks are reaching customers.
+//!
+//! Each revocation runs as one invocation of the deployed `status-notifier`, under the limits in
+//! reference/infra/webhook-config.yaml (read below, not taken from our own constants): the runtime
+//! abandons the invocation at `timeout_seconds`, and a failed event is not retried. Relying
+//! parties are in-process `HermeticTransport` endpoints; nothing leaves the machine.
+use std::sync::Arc;
+use std::time::Duration;
+
+use credentials_backend::notifier::{MemorySink, Notifier, Outcome, CANARY_ID, CANARY_URL, WEBHOOK_KIND};
+use credentials_backend::settings::{Setting, SettingsStore, PAGE_SIZE};
+use credentials_backend::status::StatusChange;
+use credentials_backend::webhook::{Endpoint, HermeticTransport};
+use serde_json::json;
+
+const DEPLOY_CONFIG: &str = include_str!("../../reference/infra/webhook-config.yaml");
+
+/// An integer setting from the deployment configuration, e.g. `timeout_seconds: 10`.
+fn deployed(key: &str) -> u64 {
+    DEPLOY_CONFIG
+        .lines()
+        .filter_map(|line| line.trim().strip_prefix(key)?.strip_prefix(':'))
+        .find_map(|value| value.split('#').next()?.trim().parse().ok())
+        .unwrap_or_else(|| panic!("webhook-config.yaml has no integer {key}"))
+}
+
+/// The hard limit after which the runtime abandons an invocation.
+fn platform_timeout() -> Duration {
+    Duration::from_secs(deployed("timeout_seconds"))
+}
+
+const LEAGUE: &str = "did:web:badges.kestrel-league.example";
+const CLUB: &str = "did:web:members.harbourclub.example";
+
+fn revoked(issuer: &str) -> StatusChange {
+    StatusChange {
+        credential_id: "urn:uuid:00000000-0000-4000-8000-000000000042".into(),
+        issuer: issuer.into(),
+        status_list: format!("{issuer}#revocation"),
+        status_index: 42,
+        revoked: true,
+    }
+}
+
+struct Rig {
+    settings: Arc<SettingsStore>,
+    transport: Arc<HermeticTransport>,
+    sink: Arc<MemorySink>,
+    notifier: Notifier,
+}
+
+fn rig() -> Rig {
+    let settings = Arc::new(SettingsStore::new());
+    let transport = Arc::new(HermeticTransport::new());
+    let sink = Arc::new(MemorySink::default());
+    let notifier = Notifier::new(settings.clone(), transport.clone(), sink.clone());
+    Rig { settings, transport, sink, notifier }
+}
+
+impl Rig {
+    fn preferences(&self, tenant: &str, count: usize) {
+        for i in 0..count {
+            self.settings.put(Setting::new(tenant, &format!("pref/{i:06}"), "preference", json!({ "n": i })));
+        }
+    }
+
+    /// Subscribes `count` relying parties to `tenant`; each answers as `endpoint(i)`.
+    fn subscribers(&self, tenant: &str, count: usize, endpoint: impl Fn(usize) -> Endpoint) -> Vec<String> {
+        (0..count)
+            .map(|i| {
+                let url = format!("https://rp-{i:03}.relying-party.example/hooks/status");
+                self.settings.put(Setting::new(tenant, &format!("webhook/rp-{i:03}"), WEBHOOK_KIND, json!({ "url": url })));
+                self.transport.route(&url, endpoint(i));
+                url
+            })
+            .collect()
+    }
+
+    /// One invocation of the deployed function for `change`, cut off where the runtime cuts it off.
+    /// `maximum_retry_attempts` is 0, so there is no second invocation. `true` if the invocation
+    /// finished before the runtime would have killed it.
+    async fn invoke(&self, change: &StatusChange) -> bool {
+        tokio::time::timeout(platform_timeout(), self.notifier.notify(change)).await.is_ok()
+    }
+
+    fn not_told<'a>(&self, urls: &'a [String]) -> Vec<&'a str> {
+        urls.iter().filter(|url| self.transport.received(url).is_empty()).map(String::as_str).collect()
+    }
+
+    /// (tenant, outcome) of every delivery event recorded for the canary.
+    fn canary_events(&self) -> Vec<(String, Outcome)> {
+        self.sink.events().into_iter().filter(|e| e.subscription == CANARY_ID).map(|e| (e.tenant, e.outcome)).collect()
+    }
+
+    /// The delivery events recorded for subscription `id` of `tenant`.
+    fn events_for(&self, tenant: &str, id: &str) -> Vec<Outcome> {
+        self.sink.events().into_iter().filter(|e| e.tenant == tenant && e.subscription == id).map(|e| e.outcome).collect()
+    }
+}
+
+#[test]
+fn the_platform_limits_are_the_ones_this_suite_runs_under() {
+    assert_eq!(deployed("timeout_seconds"), 10);
+    assert_eq!(deployed("maximum_retry_attempts"), 0, "a dropped delivery is never retried by the platform");
+    assert_eq!(deployed("query_page_size") as usize, PAGE_SIZE, "the in-repo table pages like the real one");
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_subscriber_of_a_large_account_is_told_while_the_health_check_is_green() {
+    // A large account: tens of thousands of settings, and a few dozen relying parties listening.
+    // The settings count of the real account is not known; see research-notes.md §6.
+    let rig = rig();
+    rig.preferences(LEAGUE, 25_000);
+    let urls = rig.subscribers(LEAGUE, 40, |_| Endpoint::ok());
+
+    rig.invoke(&revoked(LEAGUE)).await;
+
+    assert!(rig.notifier.canary_healthy(), "precondition: the health check is green");
+    let missed = rig.not_told(&urls);
+    assert!(
+        missed.is_empty(),
+        "health check green, but {} of {} subscribers of {LEAGUE} were never told of the revocation (first: {:?})",
+        missed.len(),
+        urls.len(),
+        missed.first()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn every_other_subscriber_is_told_when_one_endpoint_hangs_while_the_health_check_is_green() {
+    // An ordinary account. In turn, each relying party's endpoint accepts the connection and never
+    // answers (the platform's 2 s outbound limit is a *connect* timeout, so it does not apply).
+    const SUBSCRIBERS: usize = 5;
+    let mut failures = Vec::new();
+    for hung in 0..SUBSCRIBERS {
+        let rig = rig();
+        rig.preferences(CLUB, 12);
+        let urls = rig.subscribers(CLUB, SUBSCRIBERS, |i| if i == hung { Endpoint::Hang } else { Endpoint::ok() });
+
+        rig.invoke(&revoked(CLUB)).await;
+
+        assert!(rig.notifier.canary_healthy(), "precondition: the health check is green (rp-{hung:03} hanging)");
+        let others: Vec<String> = urls.iter().enumerate().filter(|(i, _)| *i != hung).map(|(_, u)| u.clone()).collect();
+        let missed = rig.not_told(&others);
+        if !missed.is_empty() {
+            failures.push(format!("rp-{hung:03} hangs: {} of {} others never told", missed.len(), others.len()));
+        }
+    }
+    assert!(failures.is_empty(), "health check green, but with one endpoint hanging:\n{}", failures.join("\n"));
+}
+
+// --- What the owners decided the fix must also guarantee (D1, D7/D8) -----------------------------
+
+#[tokio::test(start_paused = true)]
+async fn a_subscriber_that_does_not_answer_in_time_is_recorded_as_not_delivered() {
+    let rig = rig();
+    rig.preferences(CLUB, 12);
+    rig.subscribers(CLUB, 3, |i| if i == 1 { Endpoint::Hang } else { Endpoint::ok() });
+
+    assert!(rig.invoke(&revoked(CLUB)).await, "the invocation finishes inside the platform's limit");
+
+    let hung = rig.events_for(CLUB, "rp-001");
+    assert_eq!(hung.len(), 1, "exactly one event for the hung subscriber: {hung:?}");
+    assert!(matches!(hung[0], Outcome::Failed { .. }), "{hung:?}");
+    assert!(rig.notifier.canary_healthy(), "one relying party's failure is reported in its event, not the health check");
+}
+
+#[tokio::test(start_paused = true)]
+async fn the_canary_receives_the_same_change_through_the_same_transport_as_the_subscribers() {
+    let rig = rig();
+    let urls = rig.subscribers(CLUB, 2, |_| Endpoint::ok());
+
+    rig.invoke(&revoked(CLUB)).await;
+
+    let canary = rig.transport.received(CANARY_URL);
+    assert_eq!(canary.len(), 1);
+    assert_eq!(canary[0], rig.transport.received(&urls[0])[0], "the canary vouches for the same change");
+    assert!(rig.notifier.canary_healthy());
+}
+
+#[tokio::test(start_paused = true)]
+async fn health_is_not_green_when_the_subscribers_cannot_be_read_in_time() {
+    // Enough subscriptions that reading them through the index outlasts any budget inside the
+    // platform's limit; the canary must not be sent (it goes out after the lookup) and a previous
+    // green must not survive.
+    let rig = rig();
+    rig.subscribers(CLUB, 1, |_| Endpoint::ok());
+    rig.invoke(&revoked(CLUB)).await;
+    assert!(rig.notifier.canary_healthy(), "precondition: green after a healthy change");
+    for i in 0..20_000 {
+        let key = format!("webhook/bulk-{i:05}");
+        rig.settings.put(Setting::new(LEAGUE, &key, WEBHOOK_KIND, json!({ "url": "https://bulk.relying-party.example/" })));
+    }
+    let canary_calls_before = rig.transport.received(CANARY_URL).len();
+
+    assert!(rig.invoke(&revoked(LEAGUE)).await, "the invocation finishes inside the platform's limit");
+
+    assert_eq!(rig.transport.received(CANARY_URL).len(), canary_calls_before, "no canary before the lookup completes");
+    assert!(!rig.notifier.canary_healthy(), "subscribers not read in time must not leave the health check green");
+}
+
+#[tokio::test(start_paused = true)]
+async fn when_the_budget_runs_out_every_subscriber_not_reached_is_recorded_and_health_is_not_green() {
+    // More non-answering endpoints than bounded attempts fit in the budget.
+    let rig = rig();
+    rig.subscribers(CLUB, 1, |_| Endpoint::ok());
+    rig.invoke(&revoked(CLUB)).await;
+    assert!(rig.notifier.canary_healthy(), "precondition: green after a healthy change");
+    let ids: Vec<String> = (0..200).map(|i| format!("rp-{i:03}")).collect();
+    rig.subscribers(LEAGUE, ids.len(), |_| Endpoint::Hang);
+
+    assert!(rig.invoke(&revoked(LEAGUE)).await, "the invocation finishes inside the platform's limit");
+
+    for id in &ids {
+        let events = rig.events_for(LEAGUE, id);
+        assert!(matches!(events.as_slice(), [Outcome::Failed { .. }]), "{id}: expected one failed event, got {events:?}");
+    }
+    let canary = rig.canary_events();
+    assert!(
+        canary.len() == 2 && canary.iter().all(|(tenant, _)| tenant != CLUB && tenant != LEAGUE),
+        "the canary's attempt is recorded once per change, not as the customer's: {canary:?}"
+    );
+    assert!(!rig.notifier.canary_healthy(), "subscribers not reached in time must not leave the health check green");
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_webhook_setting_without_a_usable_url_is_recorded_as_not_delivered() {
+    let rig = rig();
+    rig.settings.put(Setting::new(CLUB, "webhook/rp-typo", WEBHOOK_KIND, json!({ "endpoint": "https://rp-typo.example/hook" })));
+    let urls = rig.subscribers(CLUB, 2, |_| Endpoint::ok());
+
+    assert!(rig.invoke(&revoked(CLUB)).await);
+
+    let typo = rig.events_for(CLUB, "rp-typo");
+    assert!(matches!(typo.as_slice(), [Outcome::Failed { .. }]), "expected one failed event for rp-typo, got {typo:?}");
+    assert!(rig.not_told(&urls).is_empty());
+    assert!(rig.notifier.canary_healthy(), "a customer's broken subscription is reported in its event, not the health check");
+}
+
+#[tokio::test(start_paused = true)]
+async fn the_canarys_delivery_is_not_reported_as_the_customers() {
+    let rig = rig();
+    rig.subscribers(CLUB, 1, |_| Endpoint::ok());
+
+    rig.invoke(&revoked(CLUB)).await;
+
+    assert!(rig.events_for(CLUB, CANARY_ID).is_empty(), "the customer's events include the platform canary");
+    assert_eq!(rig.canary_events().len(), 1, "the canary's attempt is still recorded");
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_customer_subscription_named_canary_does_not_stand_in_for_the_platform_canary() {
+    // The platform canary is down; a customer's subscription that happens to be called "canary"
+    // answers later. Health must follow the platform canary, not the customer's.
+    let down = rig();
+    down.transport.route(CANARY_URL, Endpoint::status(503));
+    down.settings.put(Setting::new(CLUB, "webhook/canary", WEBHOOK_KIND, json!({ "url": "https://rp-canary.example/hook" })));
+    down.transport.route("https://rp-canary.example/hook", Endpoint::slow(Duration::from_millis(300)));
+
+    down.invoke(&revoked(CLUB)).await;
+
+    assert!(!down.notifier.canary_healthy(), "the platform canary answered 503 but health is green");
+
+    // And the other way round: the platform canary is fine, the customer's "canary" fails.
+    let other = rig();
+    other.settings.put(Setting::new(CLUB, "webhook/canary", WEBHOOK_KIND, json!({ "url": "https://rp-canary.example/hook" })));
+    other.transport.route("https://rp-canary.example/hook", Endpoint::Respond { status: 503, after: Duration::from_millis(300) });
+
+    other.invoke(&revoked(CLUB)).await;
+
+    assert!(other.notifier.canary_healthy(), "a customer's failing subscription turned the health check red");
+}
