+import 'dart:convert';
+
+import 'package:credentials_app/credentials_app.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ssi/ssi.dart';
+
+import 'backend_issued.dart';
+import 'fake_issuer_client.dart';
+import 'fixtures.dart';
+
+const credentialId = 'urn:uuid:0a7230c3-bc3a-424a-839e-56dd0ea8a0d3';
+
+/// A wallet holding [issuance] for the holder of `holderSeed`.
+WalletService walletHolding(Map<String, dynamic> issuance) {
+  final store = CredentialStore()..save(HeldCredential.fromIssuance(issuance));
+  return WalletService(
+    issuer: FakeIssuerClient(),
+    store: store,
+    newKey: () => HolderKey.fromSeed(holderSeed),
+  );
+}
+
+PresentationRequest requestFor(List<String> claims, {String? nonce}) =>
+    PresentationRequest.fromJson(
+      nonce == null
+          ? doorRequestFor(claims)
+          : doorRequestFor(claims, nonce: nonce),
+    );
+
+/// Whether [presentation]'s proof verifies with the holder key over the JCS
+/// form of the presentation without its proof.
+Future<bool> holderSignatureVerifies(Map<String, dynamic> presentation) async {
+  final unsigned = Map<String, dynamic>.of(presentation)..remove('proof');
+  final signature = multiBaseToUint8List(
+    presentation['proof']['proofValue'] as String,
+  );
+  return HolderKey.fromSeed(
+    holderSeed,
+  ).verify(utf8.encode(JcsUtil.canonicalize(unsigned)), signature);
+}
+
+Map<String, dynamic> roundTrip(Map<String, dynamic> json) =>
+    jsonDecode(jsonEncode(json)) as Map<String, dynamic>;
+
+void main() {
+  test('the fixture holder is the backend credential subject', () {
+    expect(HolderKey.fromSeed(holderSeed).did, backendHolderDid);
+  });
+
+  test(
+    'presents the held credential unchanged, bound to the request nonce and domain',
+    () async {
+      final wallet = walletHolding(backendIssuance());
+      final request = requestFor(['member']);
+
+      final vp = await wallet.createPresentation(credentialId, request);
+
+      expect(vp['holder'], backendHolderDid);
+      expect(vp['verifiableCredential'], backendIssuance()['credential']);
+      expect(vp['nonce'], request.nonce);
+      expect(vp['domain'], request.clientId);
+    },
+  );
+
+  test('discloses only the claims the request asks for, as issued', () async {
+    final vp = await walletHolding(
+      backendIssuance(),
+    ).createPresentation(credentialId, requestFor(['member']));
+
+    final member = (backendIssuance()['disclosures'] as List).first;
+    expect(roundTrip(vp)['disclosures'], [member]);
+    final text = jsonEncode(vp);
+    for (final withheld in ['M-20417', 'Pärk', '1990-04-12']) {
+      expect(text, isNot(contains(withheld)));
+    }
+  });
+
+  test('a request for no claims discloses none', () async {
+    final vp = await walletHolding(
+      backendIssuance(),
+    ).createPresentation(credentialId, requestFor([]));
+    expect(roundTrip(vp)['disclosures'], isEmpty);
+  });
+
+  test(
+    'is signed by the holder did:key over the JCS form without the proof',
+    () async {
+      final vp = await walletHolding(
+        backendIssuance(),
+      ).createPresentation(credentialId, requestFor(['member']));
+
+      final proof = vp['proof'] as Map<String, dynamic>;
+      expect(proof['type'], 'Ed25519Signature2020');
+      expect(proof['verificationMethod'], HolderKey.fromSeed(holderSeed).keyId);
+      expect(proof['proofPurpose'], 'authentication');
+      expect(proof['proofValue'], startsWith('z'));
+      expect(await holderSignatureVerifies(roundTrip(vp)), isTrue);
+    },
+  );
+
+  test('the signature covers the nonce, the domain and the disclosures', () async {
+    final vp = roundTrip(
+      await walletHolding(
+        backendIssuance(),
+      ).createPresentation(credentialId, requestFor(['member'])),
+    );
+
+    expect(
+      await holderSignatureVerifies(roundTrip(vp)..['nonce'] = 'n-other'),
+      isFalse,
+    );
+    expect(
+      await holderSignatureVerifies(roundTrip(vp)..['domain'] = 'door.other'),
+      isFalse,
+    );
+    final tampered = roundTrip(vp);
+    (tampered['disclosures'] as List).first['value'] = false;
+    expect(await holderSignatureVerifies(tampered), isFalse);
+  });
+
+  test(
+    'the credential stays in the wallet and can be presented again',
+    () async {
+      final wallet = walletHolding(backendIssuance());
+
+      await wallet.createPresentation(
+        credentialId,
+        requestFor(['member'], nonce: 'n-first'),
+      );
+      final again = await wallet.createPresentation(
+        credentialId,
+        requestFor(['member'], nonce: 'n-second'),
+      );
+
+      expect(wallet.credential(credentialId), isNotNull);
+      expect(wallet.heldCredentials(), hasLength(1));
+      expect(again['nonce'], 'n-second');
+    },
+  );
+
+  test(
+    'editing the returned presentation does not change the held credential',
+    () async {
+      final wallet = walletHolding(backendIssuance());
+      final vp = await wallet.createPresentation(
+        credentialId,
+        requestFor(['member']),
+      );
+
+      (vp['verifiableCredential'] as Map<String, dynamic>)['expires_at'] = 1;
+
+      expect(
+        wallet.credential(credentialId)!.vc['expires_at'],
+        (backendIssuance()['credential'] as Map<String, dynamic>)['expires_at'],
+      );
+    },
+  );
+
+  test('refuses an expired credential', () async {
+    final issuance = backendIssuance();
+    (issuance['credential'] as Map<String, dynamic>)['expires_at'] =
+        946684800; // 2000-01-01
+    await expectLater(
+      walletHolding(
+        issuance,
+      ).createPresentation(credentialId, requestFor(['member'])),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a credential it does not hold', () async {
+    await expectLater(
+      walletHolding(
+        backendIssuance(),
+      ).createPresentation('urn:uuid:unknown', requestFor(['member'])),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a credential issued to another holder', () async {
+    final issuance = backendIssuance();
+    (issuance['credential'] as Map<String, dynamic>)['credentialSubject']['id'] =
+        'did:key:z6MkSomeoneElse';
+    await expectLater(
+      walletHolding(
+        issuance,
+      ).createPresentation(credentialId, requestFor(['member'])),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a request for a claim the credential does not carry', () async {
+    await expectLater(
+      walletHolding(
+        backendIssuance(),
+      ).createPresentation(credentialId, requestFor(['member', 'ageOver21'])),
+      throwsA(isA<WalletException>()),
+    );
+  });
+}
