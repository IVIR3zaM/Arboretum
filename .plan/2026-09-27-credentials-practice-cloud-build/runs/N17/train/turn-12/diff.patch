+import 'dart:convert';
+
+import 'package:ssi/ssi.dart' show JcsUtil, toMultiBase;
+
 import 'credential_store.dart';
 import 'held_credential.dart';
 import 'holder_key.dart';
@@ -49,10 +53,96 @@ class WalletService {
 
   /// Builds a presentation of the held credential [credentialId] in answer
   /// to [request], ready to send to the requester.
+  ///
+  /// The presentation carries the credential unchanged, the disclosures of
+  /// exactly the claims the request asks for, and the request's nonce and
+  /// domain, and is signed by the holder key (`Ed25519Signature2020` over the
+  /// JCS form without the proof). The credential stays in the wallet.
+  ///
+  /// Throws [WalletException] rather than build a presentation the verifier
+  /// will turn down: the credential is not held, not issued to this holder,
+  /// expired, or does not carry a requested claim.
   Future<Map<String, dynamic>> createPresentation(
     String credentialId,
     PresentationRequest request,
   ) async {
-    throw UnimplementedError('createPresentation');
+    final credential = _store.byId(credentialId);
+    if (credential == null) {
+      throw WalletException('No credential $credentialId in the wallet');
+    }
+    final key = holderKey();
+    if (credential.holderDid != key.did) {
+      throw WalletException(
+        'Credential $credentialId was issued to ${credential.holderDid}, not ${key.did}',
+      );
+    }
+    final expiresAt = credential.vc['expires_at'];
+    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
+    if (expiresAt is! int || now > expiresAt) {
+      throw WalletException('Credential $credentialId has expired');
+    }
+
+    final disclosures = [
+      for (final name in _requestedClaims(request))
+        credential.disclosures
+            .firstWhere(
+              (d) => d.name == name,
+              orElse: () => throw WalletException(
+                'Credential $credentialId carries no claim $name',
+              ),
+            )
+            .toJson(),
+    ];
+    // A deep copy, so the caller never holds the wallet's own credential map.
+    final presentation =
+        jsonDecode(
+              jsonEncode({
+                '@context': ['https://www.w3.org/2018/credentials/v1'],
+                'type': ['VerifiablePresentation'],
+                'holder': key.did,
+                'verifiableCredential': credential.vc,
+                'disclosures': disclosures,
+                'nonce': request.nonce,
+                'domain': request.domain,
+              }),
+            )
+            as Map<String, dynamic>;
+    final signature = await key.sign(
+      utf8.encode(JcsUtil.canonicalize(presentation)),
+    );
+    presentation['proof'] = {
+      'type': 'Ed25519Signature2020',
+      'created': now,
+      'verificationMethod': key.keyId,
+      'proofPurpose': 'authentication',
+      'proofValue': toMultiBase(signature),
+    };
+    return presentation;
+  }
+
+  /// The claim names [request] asks for, from `credentialSubject.<name>`
+  /// paths of its single credential query. No claims means none.
+  static List<String> _requestedClaims(PresentationRequest request) {
+    final queries = request.dcqlQuery.credentials;
+    if (queries.length != 1) {
+      throw WalletException(
+        'Request asks for ${queries.length} credentials; one is supported',
+      );
+    }
+    final query = queries.single;
+    if (query.claimSets != null) {
+      throw const WalletException('Requests with claim_sets are not supported');
+    }
+    final names = <String>[];
+    for (final claim in query.claims ?? const []) {
+      final path = claim.path;
+      if (path.length != 2 ||
+          path[0] != 'credentialSubject' ||
+          path[1] is! String) {
+        throw WalletException('Unsupported claim path $path');
+      }
+      if (!names.contains(path[1])) names.add(path[1] as String);
+    }
+    return names;
   }
 }
