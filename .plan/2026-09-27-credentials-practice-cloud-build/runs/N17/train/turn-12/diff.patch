+/// A membership credential as the backend's `Issuer::issue` produces it
+/// (JSON-LD, `Ed25519Signature2020`, unix-second validity), issued by Harbour
+/// Club to the holder of `holderSeed` (see fixtures.dart), valid until
+/// 2100-01-01, with the disclosures the holder receives alongside it.
+library;
+
+const backendHolderDid =
+    'did:key:z6MkvDqGT54cXesYGvABpF1UapVNwjCqRcafi4Px6Thv5T3Z';
+
+Map<String, dynamic> backendIssuance() => {
+  'credential': {
+    '@context': ['https://www.w3.org/2018/credentials/v1'],
+    'credentialStatus': {
+      'statusListId': 'did:web:members.harbourclub.example#revocation',
+      'statusListIndex': 1,
+      'type': 'StatusListEntry',
+    },
+    'credentialSubject': {
+      '_sd': [
+        '4QV0zlCLaDbg0-l75i9aJ42gG7N4Oa1wOl4gGGrDNbQ',
+        '5ys7WTTJ5dDBgEXmeuNF4vZaLlF00reewUNc3V98-3A',
+        'PoGS1vq1pBZnZnWEgwFH1pI-GnStgo0zDJdta0C0tIE',
+        'kHdfVEJN8IN9JmzB9QiSad25sp5gXqWHWC_CpiRkWC8',
+      ],
+      'id': backendHolderDid,
+    },
+    'expires_at': 4102444800,
+    'id': 'urn:uuid:0a7230c3-bc3a-424a-839e-56dd0ea8a0d3',
+    'issued_at': 1767225600,
+    'issuer': 'did:web:members.harbourclub.example',
+    'not_before': 1767225600,
+    'proof': {
+      'created': 1767225600,
+      'proofPurpose': 'assertionMethod',
+      'proofValue':
+          'z3p6ZJS9BKLu1t18SV5DFVwkShqgKbV6TKrhNeoTFemiBLaM1Spc3doDMoSjg1qvQAzpEpUt1rF38E9GJ4uLSTNhA',
+      'type': 'Ed25519Signature2020',
+      'verificationMethod': 'did:web:members.harbourclub.example#key-1',
+    },
+    'type': ['VerifiableCredential', 'MembershipCredential'],
+  },
+  'disclosures': [
+    {'name': 'member', 'salt': 'nEzmdKBcmOk-Wh4gfbZypg', 'value': true},
+    {'name': 'memberId', 'salt': 'Ly1LGA17vsxFDvvpLMPRWw', 'value': 'M-20417'},
+    {
+      'name': 'name',
+      'salt': 'BMGJ4pSy6M1N-v3w39A4pw',
+      'value': 'Ada "Pärk"\n\u{1F600}',
+    },
+    {'name': 'birthDate', 'salt': 'z4bUaSB285UABZ-quRWRng', 'value': '1990-04-12'},
+  ],
+};
+
+/// A door-scanner request for [claims] of a membership credential, shaped like
+/// an OpenID4VP request with a DCQL query. No claims means none are requested.
+Map<String, dynamic> doorRequestFor(
+  List<String> claims, {
+  String clientId = 'door.harbourclub.example',
+  String nonce = 'n-4Vq9Lx2Tb7',
+}) => {
+  'client_id': clientId,
+  'nonce': nonce,
+  'dcql_query': {
+    'credentials': [
+      {
+        'id': 'membership',
+        'format': 'ldp_vc',
+        if (claims.isNotEmpty)
+          'claims': [
+            for (final claim in claims)
+              {
+                'path': ['credentialSubject', claim],
+              },
+          ],
+      },
+    ],
