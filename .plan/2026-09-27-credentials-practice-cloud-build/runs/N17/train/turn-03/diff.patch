@@ -0,0 +1,186 @@
+//! TICKET-1: members of approved issuers are refused at the door.
+//!
+//! A `did:web` DID document is whatever the issuer hosts now (reference/did-web-method.md §3.3, §4),
+//! so a member whose credential is signed with a key the issuer publishes today must be admitted,
+//! and one signed with a key the issuer has retired must be refused.
+//!
+//! The door runs against the real onboarding data and against the documents hosted today
+//! (reference/infra/hosted-dids/), served in-process at the URLs the method spec maps each DID to.
+//! We hold no private keys for the hosted documents except Harbour Club's, so for the other
+//! issuers the hosted document is served with its public key swapped for a test key: the DID, key
+//! ids, relationships and services are the issuer's own.
+mod common;
+
+use std::sync::Arc;
+
+use credentials_backend::issuer::Issuer;
+use credentials_backend::resolver::{did_key_for, Resolver};
+use credentials_backend::store::Store;
+use credentials_backend::transport::StaticTransport;
+use credentials_backend::verifier::{VerifiedPresentation, VerifyError, Verifier};
+use ed25519_dalek::SigningKey;
+use serde_json::Value;
+
+use common::*;
+
+const CEDAR_DID: &str = "did:web:issuer.cedarrowing.example";
+const NORTH_DID: &str = "did:web:guild.northfield.example:chapters:north";
+const KESTREL_DID: &str = "did:web:badges.kestrel-league.example";
+
+/// Where the method spec (§3.2) and the hosting layout put each issuer's document.
+const HARBOUR_DOC_URL: &str = "https://members.harbourclub.example/.well-known/did.json";
+const CEDAR_DOC_URL: &str = "https://issuer.cedarrowing.example/.well-known/did.json";
+const NORTH_DOC_URL: &str = "https://guild.northfield.example/chapters/north/did.json";
+const KESTREL_DOC_URL: &str = "https://badges.kestrel-league.example/.well-known/did.json";
+
+const HOSTED_HARBOUR: &str =
+    include_str!("../../reference/infra/hosted-dids/members.harbourclub.example/.well-known/did.json");
+const HOSTED_CEDAR: &str =
+    include_str!("../../reference/infra/hosted-dids/issuer.cedarrowing.example/.well-known/did.json");
+const HOSTED_NORTH: &str =
+    include_str!("../../reference/infra/hosted-dids/guild.northfield.example/chapters/north/did.json");
+const HOSTED_KESTREL: &str =
+    include_str!("../../reference/infra/hosted-dids/badges.kestrel-league.example/.well-known/did.json");
+
+/// Test stand-ins for the keys the issuers publish today.
+const CEDAR_CURRENT_SEED: [u8; 32] = [0xC2; 32];
+const NORTH_CURRENT_SEED: [u8; 32] = [0x4E; 32];
+const KESTREL_CURRENT_SEED: [u8; 32] = [0x26; 32];
+/// Test stand-in for the key Cedar retired.
+const CEDAR_RETIRED_SEED: [u8; 32] = [0xC1; 32];
+
+fn json(text: &str) -> Value {
+    serde_json::from_str(text).expect("hosted document is JSON")
+}
+
+/// The id of the key `document` lists first under `assertionMethod`.
+fn assertion_key_id(document: &Value) -> String {
+    document["assertionMethod"][0].as_str().expect("an assertion key").to_string()
+}
+
+fn multibase(key: &SigningKey) -> String {
+    did_key_for(&key.verifying_key()).trim_start_matches("did:key:").to_string()
+}
+
+/// `document` with the public key of verification method `vm_id` replaced by `key`'s.
+fn with_key(document: &Value, vm_id: &str, key: &SigningKey) -> Value {
+    let mut document = document.clone();
+    let vm = document["verificationMethod"]
+        .as_array_mut()
+        .unwrap()
+        .iter_mut()
+        .find(|vm| vm["id"] == vm_id)
+        .unwrap_or_else(|| panic!("{vm_id} is in the document"));
+    vm["publicKeyMultibase"] = Value::String(multibase(key));
+    document
+}
+
+/// The issuer's document as served today, with the current key swapped for the test key.
+fn served(hosted: &str, current_seed: &[u8; 32]) -> Value {
+    let document = json(hosted);
+    let vm_id = assertion_key_id(&document);
+    with_key(&document, &vm_id, &SigningKey::from_bytes(current_seed))
+}
+
+/// Every approved issuer's document, at the URL the spec maps its DID to.
+fn todays_hosting() -> StaticTransport {
+    StaticTransport::default()
+        .with(HARBOUR_DOC_URL, HOSTED_HARBOUR)
+        .with(CEDAR_DOC_URL, served(HOSTED_CEDAR, &CEDAR_CURRENT_SEED).to_string())
+        .with(NORTH_DOC_URL, served(HOSTED_NORTH, &NORTH_CURRENT_SEED).to_string())
+        .with(KESTREL_DOC_URL, served(HOSTED_KESTREL, &KESTREL_CURRENT_SEED).to_string())
+}
+
+fn door(store: Arc<Store>) -> Verifier {
+    Verifier::new(Resolver::new(Arc::new(todays_hosting())), store).with_clock(|| NOW)
+}
+
+/// A member of `issuer` gets a credential and shows it at the door.
+fn admit(store: Arc<Store>, issuer: &Issuer) -> Result<VerifiedPresentation, VerifyError> {
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).expect("issuance");
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+    door(store).verify_presentation(&submission("req-1", vp), NONCE, DOMAIN)
+}
+
+/// The key ids the onboarding copy of `did` lists.
+fn onboarded_key_ids(store: &Store, did: &str) -> Vec<String> {
+    let issuer = store.onboarded_issuer(did).expect("issuer is onboarded");
+    issuer.document.verification_method.iter().map(|vm| vm.id.to_string()).collect()
+}
+
+fn onboarded_key(store: &Store, did: &str, vm_id: &str) -> String {
+    let issuer = store.onboarded_issuer(did).expect("issuer is onboarded");
+    let vm = issuer.document.verification_method.iter().find(|vm| vm.id.as_str() == vm_id).expect("key listed");
+    vm.property_set["publicKeyMultibase"].as_str().unwrap().to_string()
+}
+
+#[test]
+fn a_member_of_an_issuer_that_never_rotated_is_admitted() {
+    let hosted = json(HOSTED_HARBOUR);
+    assert_eq!(assertion_key_id(&hosted), HARBOUR_KEY_ID);
+    assert_eq!(hosted["verificationMethod"][0]["publicKeyMultibase"], HARBOUR_PUBLIC, "Harbour hosts the key we hold");
+
+    let verified = admit(store(), &harbour()).unwrap_or_else(|e| panic!("Harbour member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, HARBOUR_DID);
+}
+
+#[test]
+fn a_member_of_an_issuer_that_rotated_to_a_new_key_id_is_admitted() {
+    let store = store();
+    let current = assertion_key_id(&json(HOSTED_CEDAR));
+    assert!(!onboarded_key_ids(&store, CEDAR_DID).contains(&current), "state: Cedar rotated to {current} after onboarding");
+
+    let issuer = Issuer::new(CEDAR_DID, &current, &CEDAR_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Cedar member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, CEDAR_DID);
+}
+
+#[test]
+fn a_member_of_a_path_did_issuer_that_replaced_its_key_under_the_same_id_is_admitted() {
+    let store = store();
+    let current = assertion_key_id(&json(HOSTED_NORTH));
+    assert!(onboarded_key_ids(&store, NORTH_DID).contains(&current), "state: Northfield kept the id {current}");
+    assert_ne!(
+        onboarded_key(&store, NORTH_DID, &current),
+        json(HOSTED_NORTH)["verificationMethod"][0]["publicKeyMultibase"].as_str().unwrap(),
+        "state: Northfield hosts different key material under {current}"
+    );
+
+    let issuer = Issuer::new(NORTH_DID, &current, &NORTH_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Northfield member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer, NORTH_DID);
+}
+
+#[test]
+fn a_member_of_an_issuer_that_rotated_and_moved_its_endpoint_is_admitted_with_the_current_site() {
+    let store = store();
+    let hosted = json(HOSTED_KESTREL);
+    let current = assertion_key_id(&hosted);
+    assert!(!onboarded_key_ids(&store, KESTREL_DID).contains(&current), "state: Kestrel rotated to {current}");
+    let current_site = hosted["service"][0]["serviceEndpoint"].as_str().unwrap().to_string();
+
+    let issuer = Issuer::new(KESTREL_DID, &current, &KESTREL_CURRENT_SEED);
+    let verified = admit(store, &issuer).unwrap_or_else(|e| panic!("Kestrel member refused: {e:?}"));
+    assert_eq!(verified.credential.issuer_site.as_deref(), Some(current_site.as_str()), "door staff see today's site");
+}
+
+#[test]
+fn a_credential_signed_with_a_key_the_issuer_retired_is_refused() {
+    // Cedar as onboarded listed `#key-1`; today it hosts only `#key-2`. The onboarding copy's key
+    // is swapped for a test key so the test can sign as the retired key.
+    let store = store();
+    let retired = format!("{CEDAR_DID}#key-1");
+    let mut onboarded = store.onboarded_issuer(CEDAR_DID).unwrap();
+    let document = serde_json::to_value(&onboarded.document).unwrap();
+    let document = with_key(&document, &retired, &SigningKey::from_bytes(&CEDAR_RETIRED_SEED));
+    onboarded.document = serde_json::from_value(document).unwrap();
+    store.record_onboarded_issuer(onboarded);
+    assert!(json(HOSTED_CEDAR)["verificationMethod"].as_array().unwrap().iter().all(|vm| vm["id"] != retired.as_str()));
+
+    let issuer = Issuer::new(CEDAR_DID, &retired, &CEDAR_RETIRED_SEED);
+    match admit(store, &issuer) {
+        Err(VerifyError::UnknownKey(id)) => assert_eq!(id, retired),
+        other => panic!("a credential signed with retired {retired} must be refused as an unknown key, got {other:?}"),
+    }
+}
