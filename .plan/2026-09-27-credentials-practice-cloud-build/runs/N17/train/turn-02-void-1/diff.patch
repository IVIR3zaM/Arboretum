+//! TICKET-1: members of re-approved clubs are refused at the door.
+//!
+//! A `did:web` issuer's keys are whatever its domain serves now
+//! (`reference/did-web-method.md` §3.3, §4). These tests check the door
+//! against the documents in `reference/infra/hosted-dids/` — the current
+//! objects of the document bucket — for every approved issuer.
+
+mod common;
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use credentials_backend::issuer::Issuer;
+use credentials_backend::resolver::{did_key_for, Resolver};
+use credentials_backend::transport::MirrorTransport;
+use credentials_backend::verifier::Verifier;
+use ed25519_dalek::SigningKey;
+use serde_json::Value;
+
+use common::*;
+
+/// Every approved issuer, with the key id it currently publishes and the
+/// bucket object its document lives at (`reference/infra/did-hosting.md`).
+struct Club {
+    did: &'static str,
+    key_id: &'static str,
+    object: &'static str,
+}
+
+const HARBOUR: Club = Club {
+    did: "did:web:members.harbourclub.example",
+    key_id: "did:web:members.harbourclub.example#key-1",
+    object: "members.harbourclub.example/.well-known/did.json",
+};
+const CEDAR: Club = Club {
+    did: "did:web:issuer.cedarrowing.example",
+    key_id: "did:web:issuer.cedarrowing.example#key-2",
+    object: "issuer.cedarrowing.example/.well-known/did.json",
+};
+const NORTHFIELD: Club = Club {
+    did: "did:web:guild.northfield.example:chapters:north",
+    key_id: "did:web:guild.northfield.example:chapters:north#signing",
+    object: "guild.northfield.example/chapters/north/did.json",
+};
+const KESTREL: Club = Club {
+    did: "did:web:badges.kestrel-league.example",
+    key_id: "did:web:badges.kestrel-league.example#key-2026",
+    object: "badges.kestrel-league.example/.well-known/did.json",
+};
+
+fn hosted_dids() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../reference/infra/hosted-dids")
+}
+
+fn published_document(club: &Club) -> Value {
+    serde_json::from_slice(&std::fs::read(hosted_dids().join(club.object)).unwrap()).unwrap()
+}
+
+fn published_key(document: &Value, key_id: &str) -> String {
+    document["verificationMethod"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|vm| vm["id"] == key_id)
+        .and_then(|vm| vm["publicKeyMultibase"].as_str())
+        .unwrap_or_else(|| panic!("{key_id} is published"))
+        .to_string()
+}
+
+// --- the key the door checks against ------------------------------------
+
+/// The key the verifier would check `club`'s credentials with must be the one
+/// the club's domain serves now.
+fn door_uses_the_published_key(club: &Club) {
+    let published = published_key(&published_document(club), club.key_id);
+    let resolver = Resolver::new(Arc::new(MirrorTransport::new(hosted_dids())));
+    let verifier = Verifier::new(resolver, store()).with_clock(|| NOW);
+
+    let document = verifier.resolve_issuer(club.did).unwrap_or_else(|e| panic!("{}: {e}", club.did));
+    let checked: Vec<(String, String)> = document
+        .verification_method
+        .iter()
+        .map(|vm| (vm.id.to_string(), vm.property_set["publicKeyMultibase"].as_str().unwrap_or_default().to_string()))
+        .collect();
+    assert!(
+        checked.iter().any(|(id, key)| id == club.key_id && *key == published),
+        "{}: door checks {checked:?}, club publishes {} {published}",
+        club.did,
+        club.key_id
+    );
+}
+
+#[test]
+fn door_checks_harbour_against_its_published_key() {
+    door_uses_the_published_key(&HARBOUR);
+}
+
+#[test]
+fn door_checks_cedar_against_its_published_key() {
+    door_uses_the_published_key(&CEDAR);
+}
+
+#[test]
+fn door_checks_northfield_against_its_published_key() {
+    door_uses_the_published_key(&NORTHFIELD);
+}
+
+#[test]
+fn door_checks_kestrel_against_its_published_key() {
+    door_uses_the_published_key(&KESTREL);
+}
+
+// --- a member at the door -----------------------------------------------
+
+/// A copy of the bucket in a scratch directory, where `club`'s current
+/// document publishes `public` under its current key id. Everything else —
+/// object layout, ids, relationships, services — is the published copy.
+fn bucket_with_key(name: &str, club: &Club, public: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("ticket-1-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    copy_dir(&hosted_dids(), &root);
+    let mut document = published_document(club);
+    for vm in document["verificationMethod"].as_array_mut().unwrap() {
+        if vm["id"] == club.key_id {
+            vm["publicKeyMultibase"] = Value::String(public.to_string());
+        }
+    }
+    std::fs::write(root.join(club.object), serde_json::to_vec_pretty(&document).unwrap()).unwrap();
+    root
+}
+
+fn copy_dir(from: &Path, to: &Path) {
+    std::fs::create_dir_all(to).unwrap();
+    for entry in std::fs::read_dir(from).unwrap() {
+        let entry = entry.unwrap();
+        let target = to.join(entry.file_name());
+        if entry.file_type().unwrap().is_dir() {
+            copy_dir(&entry.path(), &target);
+        } else {
+            std::fs::copy(entry.path(), target).unwrap();
+        }
+    }
+}
+
+/// A member of `club` gets a credential signed with the key the club
+/// publishes now, and presents it at the door.
+fn member_is_admitted(club: &Club, signing_seed: [u8; 32], bucket: &Path) {
+    let store = store();
+    let issuer = Issuer::new(club.did, club.key_id, &signing_seed);
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let resolver = Resolver::new(Arc::new(MirrorTransport::new(bucket)));
+    let verifier = Verifier::new(resolver, store).with_clock(|| NOW);
+    let result = verifier.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN);
+    assert!(result.is_ok(), "{} member refused at the door: {:?}", club.did, result.err());
+}
+
+/// Harbour's current key is the fixture key the suite holds.
+#[test]
+fn a_harbour_member_is_admitted() {
+    let seed = seed(HARBOUR_SEED);
+    assert_eq!(did_key_for(&SigningKey::from_bytes(&seed).verifying_key()), format!("did:key:{HARBOUR_PUBLIC}"));
+    assert_eq!(published_key(&published_document(&HARBOUR), HARBOUR.key_id), HARBOUR_PUBLIC);
+    member_is_admitted(&HARBOUR, seed, &hosted_dids());
+}
+
+/// The suite doesn't hold the rotated clubs' private keys, so each of these
+/// publishes a test key under the club's current key id, in a copy of the
+/// bucket that is otherwise the published one.
+fn rotated_member_is_admitted(name: &str, club: &Club, seed_byte: u8) {
+    let key = SigningKey::from_bytes(&[seed_byte; 32]);
+    let public = did_key_for(&key.verifying_key()).trim_start_matches("did:key:").to_string();
+    let bucket = Scratch(bucket_with_key(name, club, &public));
+    member_is_admitted(club, key.to_bytes(), &bucket.0);
+}
+
+/// Removes the scratch bucket even when the test fails.
+struct Scratch(PathBuf);
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn a_cedar_member_is_admitted() {
+    rotated_member_is_admitted("cedar", &CEDAR, 0xC1);
+}
+
+#[test]
+fn a_northfield_member_is_admitted() {
+    rotated_member_is_admitted("northfield", &NORTHFIELD, 0xC2);
+}
+
+#[test]
+fn a_kestrel_member_is_admitted() {
+    rotated_member_is_admitted("kestrel", &KESTREL, 0xC3);
+}
