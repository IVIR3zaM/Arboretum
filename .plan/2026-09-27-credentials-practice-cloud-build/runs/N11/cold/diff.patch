+#[test]
+fn did_web_maps_path_segments_without_the_well_known_directory() {
+    assert_eq!(
+        did_web_url("did:web:guild.northfield.example:chapters:north").unwrap(),
+        "https://guild.northfield.example/chapters/north/did.json"
+    );
+    assert_eq!(did_web_url("did:web:example.com%3A3000:user:alice").unwrap(), "https://example.com:3000/user/alice/did.json");
+}
+
+#[test]
+fn every_onboarded_issuer_resolves_from_the_bucket_mirror() {
+    let resolver = Resolver::new(Arc::new(MirrorTransport::from_env()));
+    for issuer in store().onboarded_issuers() {
+        let doc = resolver.resolve(&issuer.did).unwrap_or_else(|e| panic!("{}: {e}", issuer.did));
+        assert_eq!(doc.id.as_str(), issuer.did);
+        assert!(!doc.assertion_method.is_empty(), "{} publishes no assertion key", issuer.did);
+    }
+}
