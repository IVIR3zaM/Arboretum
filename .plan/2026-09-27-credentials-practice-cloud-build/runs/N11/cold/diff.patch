+
+/// Harbour after rotating `#key-1` out for `#key-2` in the issuer console.
+fn rotated_harbour() -> (Issuer, Value) {
+    let key_id = format!("{HARBOUR_DID}#key-2");
+    let issuer = Issuer::new(HARBOUR_DID, &key_id, &[0x42; 32]);
+    let mut document = harbour_document();
+    document["verificationMethod"][0]["id"] = json!(key_id);
+    document["verificationMethod"][0]["publicKeyMultibase"] =
+        json!(did_key_for(&issuer.verifying_key()).trim_start_matches("did:key:"));
+    document["authentication"] = json!([key_id]);
+    document["assertionMethod"] = json!([key_id]);
+    document["service"][0]["serviceEndpoint"] = json!("https://harbourclub.example/members/");
+    (issuer, document)
+}
+
+fn verifier_serving(document: &Value, store: Arc<Store>) -> Verifier {
+    let transport = StaticTransport::default().with(HARBOUR_URL, document.to_string());
+    Verifier::new(Resolver::new(Arc::new(transport)), store).with_clock(|| NOW)
+}
+
+#[test]
+fn a_credential_signed_with_a_rotated_key_is_accepted() {
+    let store = store();
+    let holder = Holder::new(1);
+    let (issuer, document) = rotated_harbour();
+    let issued = issuer.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let verified =
+        verifier_serving(&document, store).verify_presentation(&submission("req-1", vp), NONCE, DOMAIN).unwrap();
+    assert_eq!(verified.credential.issuer, HARBOUR_DID);
+    assert_eq!(verified.credential.issuer_site.as_deref(), Some("https://harbourclub.example/members/"));
+}
+
+#[test]
+fn a_credential_signed_with_a_retired_key_is_rejected() {
+    let store = store();
+    let holder = Holder::new(1);
+    let (_, document) = rotated_harbour();
+    let issued = harbour().issue(&store, &membership_request(&holder)).unwrap();
+
+    let err = verifier_serving(&document, store).verify_credential(&issued.credential).unwrap_err();
+    assert!(matches!(err, VerifyError::UnknownKey(ref id) if id == HARBOUR_KEY_ID), "{err:?}");
+}
