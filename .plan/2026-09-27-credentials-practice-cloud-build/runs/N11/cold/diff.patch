+/// Harbour's hosted document after rotating from `key-1` to `key-2`; the
+/// onboarding snapshot in the store still lists only `key-1`.
+fn rotated_verifier(store: Arc<Store>, new_key: &ed25519_dalek::SigningKey) -> Verifier {
+    let key_id = format!("{HARBOUR_DID}#key-2");
+    let mut doc = harbour_document();
+    doc["verificationMethod"][0]["id"] = json!(key_id);
+    doc["verificationMethod"][0]["publicKeyMultibase"] =
+        json!(did_key_for(&new_key.verifying_key()).trim_start_matches("did:key:"));
+    doc["authentication"] = json!([key_id]);
+    doc["assertionMethod"] = json!([key_id]);
+    doc["service"][0]["serviceEndpoint"] = json!("https://harbourclub.example/members/");
+    let transport = StaticTransport::default().with(HARBOUR_URL, doc.to_string());
+    Verifier::new(Resolver::new(Arc::new(transport)), store).with_clock(|| NOW)
+}
+
+#[test]
+fn a_credential_signed_with_a_rotated_issuer_key_is_accepted() {
+    let store = store();
+    let holder = Holder::new(1);
+    let new_key = ed25519_dalek::SigningKey::from_bytes(&[42; 32]);
+    let rotated = Issuer::new(HARBOUR_DID, &format!("{HARBOUR_DID}#key-2"), &new_key.to_bytes());
+    let issued = rotated.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+
+    let verified =
+        rotated_verifier(store, &new_key).verify_presentation(&submission("req-1", vp), NONCE, DOMAIN).unwrap();
+    assert_eq!(verified.credential.issuer, HARBOUR_DID);
+    assert_eq!(verified.credential.issuer_site.as_deref(), Some("https://harbourclub.example/members/"));
+}
+
+#[test]
+fn a_credential_signed_with_a_retired_issuer_key_is_rejected() {
+    let store = store();
+    let holder = Holder::new(1);
+    let issued = harbour().issue(&store, &membership_request(&holder)).unwrap();
+    let new_key = ed25519_dalek::SigningKey::from_bytes(&[42; 32]);
+
+    let err = rotated_verifier(store, &new_key).verify_credential(&issued.credential).unwrap_err();
+    assert!(matches!(err, VerifyError::UnknownKey(ref id) if id == HARBOUR_KEY_ID), "{err:?}");
+}
+
