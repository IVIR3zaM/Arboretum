+
+/// Harbour after rotating to `#key-2`: the document it now serves, while the
+/// store still holds the copy recorded at onboarding.
+fn rotated_harbour(store: Arc<Store>) -> (Issuer, Verifier) {
+    let key_id = format!("{HARBOUR_DID}#key-2");
+    let issuer = Issuer::new(HARBOUR_DID, &key_id, &[42; 32]);
+    let multibase = did_key_for(&issuer.verifying_key()).trim_start_matches("did:key:").to_string();
+    let mut document = harbour_document();
+    document["verificationMethod"][0]["id"] = json!(key_id);
+    document["verificationMethod"][0]["publicKeyMultibase"] = json!(multibase);
+    document["authentication"] = json!([key_id]);
+    document["assertionMethod"] = json!([key_id]);
+    let transport = StaticTransport::default().with(HARBOUR_URL, document.to_string());
+    let verifier = Verifier::new(Resolver::new(Arc::new(transport)), store).with_clock(|| NOW);
+    (issuer, verifier)
+}
+
+#[test]
+fn a_credential_signed_with_a_rotated_key_is_accepted() {
+    let store = store();
+    let (issuer, verifier) = rotated_harbour(store.clone());
+    let holder = Holder::new(1);
+    let issued = issuer.issue(&store, &membership_request(&holder)).unwrap();
+    let vp = holder.present(&issued, &["member"], NONCE, DOMAIN);
+    let verified = verifier.verify_presentation(&submission("req-1", vp), NONCE, DOMAIN).unwrap();
+    assert_eq!(verified.credential.issuer, HARBOUR_DID);
+}
+
+#[test]
+fn a_credential_signed_with_a_retired_key_is_rejected() {
+    let store = store();
+    let (_, verifier) = rotated_harbour(store.clone());
+    let holder = Holder::new(1);
+    let issued = harbour().issue(&store, &membership_request(&holder)).unwrap();
+    let err = verifier.verify_credential(&issued.credential).unwrap_err();
+    assert!(matches!(err, VerifyError::UnknownKey(ref id) if id == HARBOUR_KEY_ID), "{err:?}");
+}
