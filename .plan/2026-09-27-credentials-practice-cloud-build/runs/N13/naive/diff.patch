@@ -49,10 +57,121 @@ class WalletService {
 
   /// Builds a presentation of the held credential [credentialId] in answer
   /// to [request], ready to send to the requester.
+  ///
+  /// The presentation carries the credential exactly as issued plus the
+  /// disclosures for the claims the request asks for — no others — and is
+  /// bound to the request's `nonce` and `domain` by an
+  /// `Ed25519Signature2020` proof made with the holder key, over the RFC 8785
+  /// canonical form of the presentation without its `proof`.
   Future<Map<String, dynamic>> createPresentation(
     String credentialId,
     PresentationRequest request,
   ) async {
-    throw UnimplementedError('createPresentation');
+    final credential = _store.byId(credentialId);
+    if (credential == null) {
+      throw WalletException('No credential $credentialId in the wallet');
+    }
+    final key = holderKey();
+    if (credential.holderDid != key.did) {
+      throw WalletException(
+        'Credential $credentialId was issued to ${credential.holderDid}, not ${key.did}',
+      );
+    }
+    final query = request.dcqlQuery.credentials
+        .where((query) => _matches(credential, query))
+        .firstOrNull;
+    if (query == null) {
+      throw WalletException(
+        'Credential $credentialId does not match what ${request.clientId} asked for',
+      );
+    }
+
+    final presentation = <String, dynamic>{
+      '@context': ['https://www.w3.org/2018/credentials/v1'],
+      'type': ['VerifiablePresentation'],
+      'holder': key.did,
+      'verifiableCredential': credential.vc,
+      'disclosures': [
+        for (final disclosure in _requestedDisclosures(credential, query))
+          disclosure.toJson(),
+      ],
+      'nonce': request.nonce,
+      'domain': request.domain,
+    };
+    final signature = await key.sign(
+      utf8.encode(JcsUtil.canonicalize(presentation)),
+    );
+    presentation['proof'] = {
+      'type': 'Ed25519Signature2020',
+      'created': _clock().millisecondsSinceEpoch ~/ 1000,
+      'verificationMethod': key.keyId,
+      'proofPurpose': 'authentication',
+      'proofValue': toMultiBase(signature),
+    };
+    return presentation;
+  }
+
+  /// Whether [credential] can answer [query]: format, types, and every
+  /// requested claim held.
+  bool _matches(HeldCredential credential, DcqlCredential query) {
+    if (query.format != CredentialFormat.ldpVc) return false;
+    final typeValues = query.meta?.typeValues;
+    if (typeValues != null) {
+      final types = credential.vc['type'];
+      final held = types is List ? types.toSet() : {types};
+      if (!typeValues.any((wanted) => held.containsAll(wanted))) return false;
+    }
+    try {
+      _requestedDisclosures(credential, query);
+      return true;
+    } on WalletException {
+      return false;
+    }
+  }
+
+  /// The disclosures for the claims [query] names, each of which must be a
+  /// `credentialSubject` claim the holder was issued. With `claim_sets`, the
+  /// first set the credential can satisfy. A query that names no claims gets
+  /// none.
+  List<Disclosure> _requestedDisclosures(
+    HeldCredential credential,
+    DcqlCredential query,
+  ) {
+    final claims = query.claims ?? const <DcqlClaim>[];
+    final claimSets = query.claimSets;
+    if (claimSets == null) {
+      return [for (final claim in claims) _disclosureFor(credential, claim)];
+    }
+    for (final ids in claimSets) {
+      try {
+        return [
+          for (final id in ids)
+            _disclosureFor(credential, claims.firstWhere((c) => c.id == id)),
+        ];
+      } on WalletException {
+        continue;
+      }
+    }
+    throw WalletException(
+      'Credential ${credential.id} satisfies none of the requested claim sets',
+    );
+  }
+
+  Disclosure _disclosureFor(HeldCredential credential, DcqlClaim claim) {
+    final path = claim.path;
+    if (path.length != 2 || path.first != 'credentialSubject') {
+      throw WalletException('Cannot disclose claim at $path');
+    }
+    final disclosure = credential.disclosures
+        .where((d) => d.name == path.last)
+        .firstOrNull;
+    if (disclosure == null) {
+      throw WalletException('Credential ${credential.id} has no claim $path');
+    }
+    final values = claim.values;
+    if (values != null && !values.contains(disclosure.value)) {
+      throw WalletException('Claim $path does not have a requested value');
+    }
+    return disclosure;
   }
 }
diff --git a/app/test/wallet_service_test.dart b/app/test/wallet_service_test.dart
