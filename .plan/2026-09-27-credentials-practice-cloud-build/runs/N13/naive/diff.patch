 import 'fixtures.dart';
@@ -57,4 +60,157 @@ void main() {
     final json = doorRequest()..remove('nonce');
     expect(() => PresentationRequest.fromJson(json), throwsFormatException);
   });
+
+  group('createPresentation', () {
+    const credentialId = 'urn:uuid:5b1d7c2e-0f7a-4c3e-9d0b-6a2f1e8c4d11';
+
+    Future<WalletService> walletHoldingMembership() async {
+      final wallet = WalletService(
+        issuer: FakeIssuerClient(),
+        newKey: () => HolderKey.fromSeed(holderSeed),
+        clock: () => DateTime.utc(2026, 6, 1),
+      );
+      await wallet.requestCredential('MembershipCredential');
+      return wallet;
+    }
+
+    PresentationRequest requestFor(List<List<String>> paths) {
+      final json = doorRequest();
+      json['dcql_query']['credentials'][0]['claims'] = [
+        for (final path in paths) {'path': path},
+      ];
+      return PresentationRequest.fromJson(json);
+    }
+
+    test('presents the credential with only the requested claims', () async {
+      final wallet = await walletHoldingMembership();
+      final request = PresentationRequest.fromJson(doorRequest());
+
+      final vp = await wallet.createPresentation(credentialId, request);
+
+      expect(vp['type'], ['VerifiablePresentation']);
+      expect(vp['holder'], holderDid);
+      expect(vp['nonce'], 'n-8f3Kq2xWz0Lb');
+      expect(vp['domain'], 'door-scanner.members.test');
+      expect(vp['verifiableCredential'], membershipIssuance()['credential']);
+      expect(vp['disclosures'], [
+        {'salt': 'Qg8wYx1dLr0pVb3kTz7sNw', 'name': 'member', 'value': true},
+      ]);
+    });
+
+    test('signs the presentation with the holder key', () async {
+      final wallet = await walletHoldingMembership();
+      final request = PresentationRequest.fromJson(doorRequest());
+
+      final vp = await wallet.createPresentation(credentialId, request);
+
+      final proof = vp['proof'] as Map<String, dynamic>;
+      expect(proof['type'], 'Ed25519Signature2020');
+      expect(proof['verificationMethod'], wallet.holderKey().keyId);
+      expect(proof['proofPurpose'], 'authentication');
+      expect(proof['created'], 1780272000);
+      final unsigned = Map<String, dynamic>.of(vp)..remove('proof');
+      final signed = utf8.encode(JcsUtil.canonicalize(unsigned));
+      final signature = multiBaseToUint8List(proof['proofValue'] as String);
+      expect(await wallet.holderKey().verify(signed, signature), isTrue);
+
+      final tampered = Map<String, dynamic>.of(unsigned)..['nonce'] = 'other';
+      expect(
+        await wallet.holderKey().verify(
+          utf8.encode(JcsUtil.canonicalize(tampered)),
+          signature,
+        ),
+        isFalse,
+      );
+    });
+
+    test('discloses several requested claims', () async {
+      final wallet = await walletHoldingMembership();
+      final request = requestFor([
+        ['credentialSubject', 'member'],
+        ['credentialSubject', 'memberId'],
+      ]);
+
+      final vp = await wallet.createPresentation(credentialId, request);
+
+      final names = (vp['disclosures'] as List).map((d) => d['name']);
+      expect(names, ['member', 'memberId']);
+    });
+
+    test('uses the first claim set the credential satisfies', () async {
+      final wallet = await walletHoldingMembership();
+      final json = doorRequest();
+      json['dcql_query']['credentials'][0]
+        ..['claims'] = [
+          {'id': 'tier', 'path': ['credentialSubject', 'tier']},
+          {'id': 'member', 'path': ['credentialSubject', 'member']},
+        ]
+        ..['claim_sets'] = [
+          ['tier'],
+          ['member'],
+        ];
+
+      final vp = await wallet.createPresentation(
+        credentialId,
+        PresentationRequest.fromJson(json),
+      );
+
+      final names = (vp['disclosures'] as List).map((d) => d['name']);
+      expect(names, ['member']);
+    });
+
+    test('refuses a claim the credential does not hold', () async {
+      final wallet = await walletHoldingMembership();
+      final request = requestFor([
+        ['credentialSubject', 'member'],
+        ['credentialSubject', 'tier'],
+      ]);
+      await expectLater(
+        wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a request for another credential type', () async {
+      final wallet = await walletHoldingMembership();
+      final json = doorRequest();
+      json['dcql_query']['credentials'][0]['meta'] = {
+        'type_values': [
+          ['VerifiableCredential', 'TicketCredential'],
+        ],
+      };
+      await expectLater(
+        wallet.createPresentation(
+          credentialId,
+          PresentationRequest.fromJson(json),
+        ),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a request for another format', () async {
+      final wallet = await walletHoldingMembership();
+      final json = doorRequest();
+      json['dcql_query']['credentials'][0]['format'] = 'dc+sd-jwt';
+      json['dcql_query']['credentials'][0]['meta'] = {
+        'vct_values': ['MembershipCredential'],
+      };
+      await expectLater(
+        wallet.createPresentation(
+          credentialId,
+          PresentationRequest.fromJson(json),
+        ),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a credential the wallet does not hold', () async {
+      final wallet = await walletHoldingMembership();
+      final request = PresentationRequest.fromJson(doorRequest());
+      await expectLater(
+        wallet.createPresentation('urn:uuid:unknown', request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
 }
