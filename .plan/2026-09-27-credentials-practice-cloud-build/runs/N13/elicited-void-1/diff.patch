index 0000000..a82d5a6
--- /dev/null
+++ b/app/lib/src/presentation_builder.dart
@@ -0,0 +1,172 @@
+import 'dart:convert';
+
+import 'package:dcql/dcql.dart';
+import 'package:ssi/ssi.dart';
+
+import 'held_credential.dart';
+import 'holder_key.dart';
+import 'presentation_request.dart';
+import 'wallet_service.dart';
+
+const _presentationContext = 'https://www.w3.org/2018/credentials/v1';
+const _proofType = 'Ed25519Signature2020';
+
+/// Builds the holder-signed presentation of [credential] that answers
+/// [request], in the shape the backend verifier checks.
+///
+/// Only the claims the request's DCQL query names are disclosed, each as the
+/// issuer's disclosure unchanged, next to the unchanged credential. The
+/// request's nonce and client id are bound in as `nonce` and `domain`, and the
+/// whole presentation is signed with [key] for `authentication`, over the
+/// RFC 8785 form of the presentation without its `proof`.
+///
+/// Refuses a credential whose `expires_at` (unix seconds) is before [now].
+Future<Map<String, dynamic>> buildPresentation({
+  required HeldCredential credential,
+  required PresentationRequest request,
+  required HolderKey key,
+  required DateTime now,
+}) async {
+  final nowSeconds = now.millisecondsSinceEpoch ~/ 1000;
+  final expiresAt = credential.vc['expires_at'];
+  if (expiresAt is! int) {
+    throw WalletException('Credential ${credential.id} has no expires_at');
+  }
+  if (nowSeconds > expiresAt) {
+    throw WalletException('Credential ${credential.id} has expired');
+  }
+  if (credential.holderDid != key.did) {
+    throw WalletException(
+      'Credential ${credential.id} is about ${credential.holderDid}, '
+      'not this holder ${key.did}',
+    );
+  }
+
+  final query = _credentialQuery(credential, request.dcqlQuery);
+  final disclosures = _requestedDisclosures(credential, query);
+
+  final presentation = <String, dynamic>{
+    '@context': [_presentationContext],
+    'type': ['VerifiablePresentation'],
+    'holder': key.did,
+    'verifiableCredential': _copy(credential.vc),
+    'disclosures': [for (final d in disclosures) _copy(d.toJson())],
+    'nonce': request.nonce,
+    'domain': request.domain,
+  };
+  final signature = await key.sign(
+    utf8.encode(JcsUtil.canonicalize(presentation)),
+  );
+  presentation['proof'] = {
+    'type': _proofType,
+    'created': nowSeconds,
+    'verificationMethod': key.keyId,
+    'proofPurpose': 'authentication',
+    'proofValue': toMultiBase(signature),
+  };
+  return presentation;
+}
+
+/// The one credential query in [query] that [credential] answers.
+DcqlCredential _credentialQuery(
+  HeldCredential credential,
+  DcqlCredentialQuery query,
+) {
+  if (query.credentials.length > 1) {
+    throw const WalletException(
+      'The request asks for more than one credential',
+    );
+  }
+  final types = _types(credential.vc);
+  final matching = query.credentials.where((c) {
+    if (c.format != CredentialFormat.ldpVc) return false;
+    final typeValues = c.meta?.typeValues;
+    if (typeValues == null) return true;
+    return typeValues.any((wanted) => wanted.every(types.contains));
+  }).toList();
+  if (matching.isEmpty) {
+    throw WalletException(
+      'The request asks for no credential like ${credential.id}',
+    );
+  }
+  return matching.single;
+}
+
+/// The issuer's disclosures for exactly the claims [query] names.
+///
+/// With `claim_sets`, the first set this credential satisfies wins; without
+/// them every claim must be satisfied. A claim that sits in the credential
+/// itself (such as `credentialSubject.id`) is already presented and needs no
+/// disclosure. No `claims` at all means no selectively disclosable claims.
+List<Disclosure> _requestedDisclosures(
+  HeldCredential credential,
+  DcqlCredential query,
+) {
+  final claims = query.claims;
+  if (claims == null || claims.isEmpty) return const [];
+
+  final claimSets = query.claimSets;
+  if (claimSets == null) {
+    return _satisfy(credential, claims) ??
+        (throw WalletException(
+          'Credential ${credential.id} cannot answer query ${query.id}',
+        ));
+  }
+  for (final set in claimSets) {
+    final chosen = claims.where((c) => set.contains(c.id)).toList();
+    if (chosen.length != set.length) continue;
+    final disclosures = _satisfy(credential, chosen);
+    if (disclosures != null) return disclosures;
+  }
+  throw WalletException(
+    'Credential ${credential.id} satisfies no claim set of query ${query.id}',
+  );
+}
+
+/// The disclosures answering every one of [claims], or null if one can't be.
+List<Disclosure>? _satisfy(HeldCredential credential, List<DcqlClaim> claims) {
+  final disclosures = <Disclosure>[];
+  for (final claim in claims) {
+    final path = claim.path;
+    final disclosure =
+        path.length == 2 && path[0] == 'credentialSubject' && path[1] is String
+        ? credential.disclosures.where((d) => d.name == path[1]).firstOrNull
+        : null;
+    if (disclosure != null) {
+      if (!_allowed(claim, disclosure.value)) return null;
+      if (!disclosures.contains(disclosure)) disclosures.add(disclosure);
+      continue;
+    }
+    final (found, value) = _lookup(credential.vc, path);
+    if (!found || !_allowed(claim, value)) return null;
+  }
+  return disclosures;
+}
+
+bool _allowed(DcqlClaim claim, Object? value) =>
+    claim.values == null || claim.values!.contains(value);
+
+/// Follows a claims path of names and indexes through [vc].
+(bool, Object?) _lookup(Map<String, dynamic> vc, List<dynamic> path) {
+  Object? current = vc;
+  for (final step in path) {
+    if (step is String && current is Map && current.containsKey(step)) {
+      current = current[step];
+    } else if (step is int && current is List && step < current.length) {
+      current = current[step];
+    } else {
+      return (false, null);
+    }
+  }
+  return (true, current);
+}
+
+List<String> _types(Map<String, dynamic> vc) {
+  final types = vc['type'];
+  if (types is List) return types.whereType<String>().toList();
+  return types is String ? [types] : const [];
+}
+
+/// A deep copy, so the presentation never aliases what the wallet holds.
+Map<String, dynamic> _copy(Map<String, dynamic> json) =>
+    jsonDecode(jsonEncode(json)) as Map<String, dynamic>;
