@@ -0,0 +1,382 @@
+import 'dart:convert';
+
+import 'package:credentials_app/credentials_app.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ssi/ssi.dart';
+
+import 'fake_issuer_client.dart';
+import 'fixtures.dart';
+
+const credentialId = 'urn:uuid:5b1d7c2e-0f7a-4c3e-9d0b-6a2f1e8c4d11';
+
+/// A wallet holding the fixture credential under the fixture holder key.
+({WalletService wallet, FakeIssuerClient issuer}) walletWith({
+  Map<String, dynamic>? issuance,
+  DateTime? now,
+}) {
+  final store = CredentialStore()
+    ..holderKey = HolderKey.fromSeed(holderSeed)
+    ..save(HeldCredential.fromIssuance(issuance ?? membershipIssuance()));
+  final issuer = FakeIssuerClient();
+  final wallet = WalletService(
+    issuer: issuer,
+    store: store,
+    clock: () => now ?? testNow,
+  );
+  return (wallet: wallet, issuer: issuer);
+}
+
+PresentationRequest requestFor(Map<String, dynamic> credentialQuery) {
+  final json = doorRequest();
+  json['dcql_query'] = {
+    'credentials': [credentialQuery],
+  };
+  return PresentationRequest.fromJson(json);
+}
+
+Map<String, dynamic> membershipQuery(List<Map<String, dynamic>>? claims) => {
+  'id': 'membership',
+  'format': 'ldp_vc',
+  'claims': ?claims,
+};
+
+Future<bool> holderSignatureVerifies(Map<String, dynamic> vp) {
+  final unsigned = Map.of(vp)..remove('proof');
+  final proofValue = (vp['proof'] as Map)['proofValue'] as String;
+  return HolderKey.fromSeed(holderSeed).verify(
+    utf8.encode(JcsUtil.canonicalize(unsigned)),
+    multiBaseToUint8List(proofValue),
+  );
+}
+
+void main() {
+  final door = PresentationRequest.fromJson(doorRequest());
+
+  group('disclosure', () {
+    test('discloses only the claim the door asks for', () async {
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        door,
+      );
+      expect(vp['disclosures'], [
+        {'salt': 'Qg8wYx1dLr0pVb3kTz7sNw', 'name': 'member', 'value': true},
+      ]);
+      final wire = jsonEncode(vp);
+      for (final secret in ['Ada Park', 'M-20417', '1990-04-12']) {
+        expect(wire, isNot(contains(secret)));
+      }
+      for (final salt in [
+        'bM4rT9cZ2xKq1nVf0hJw8A',
+        'u7EoH3pWq5sLd2yGk9rCzQ',
+        'X2nR6vBt1fYk8mJq4cLwEg',
+      ]) {
+        expect(wire, isNot(contains(salt)));
+      }
+    });
+
+    test('carries the credential exactly as issued', () async {
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        door,
+      );
+      expect(vp['verifiableCredential'], membershipIssuance()['credential']);
+    });
+
+    test('discloses each requested claim once, in query order', () async {
+      final request = requestFor(
+        membershipQuery([
+          {
+            'path': ['credentialSubject', 'memberId'],
+          },
+          {
+            'path': ['credentialSubject', 'member'],
+          },
+          {
+            'path': ['credentialSubject', 'member'],
+          },
+        ]),
+      );
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        request,
+      );
+      expect((vp['disclosures'] as List).map((d) => d['name']), [
+        'memberId',
+        'member',
+      ]);
+    });
+
+    test('a query without claims discloses nothing', () async {
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        requestFor(membershipQuery(null)),
+      );
+      expect(vp['disclosures'], isEmpty);
+    });
+
+    test('a claim already in the credential needs no disclosure', () async {
+      final request = requestFor(
+        membershipQuery([
+          {
+            'path': ['credentialSubject', 'id'],
+            'values': [holderDid],
+          },
+        ]),
+      );
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        request,
+      );
+      expect(vp['disclosures'], isEmpty);
+    });
+
+    test('uses the first claim set the credential satisfies', () async {
+      final request = requestFor({
+        ...membershipQuery([
+          {
+            'id': 'tier',
+            'path': ['credentialSubject', 'tier'],
+          },
+          {
+            'id': 'member',
+            'path': ['credentialSubject', 'member'],
+          },
+          {
+            'id': 'name',
+            'path': ['credentialSubject', 'name'],
+          },
+        ]),
+        'claim_sets': [
+          ['tier'],
+          ['member'],
+          ['name'],
+        ],
+      });
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        request,
+      );
+      expect((vp['disclosures'] as List).map((d) => d['name']), ['member']);
+    });
+
+    test('refuses a claim the credential does not hold', () async {
+      final request = requestFor(
+        membershipQuery([
+          {
+            'path': ['credentialSubject', 'tier'],
+          },
+        ]),
+      );
+      await expectLater(
+        walletWith().wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a claim whose value the request does not accept', () async {
+      final request = requestFor(
+        membershipQuery([
+          {
+            'path': ['credentialSubject', 'member'],
+            'values': [false],
+          },
+        ]),
+      );
+      await expectLater(
+        walletWith().wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a request for another credential format', () async {
+      final request = requestFor({
+        ...membershipQuery(null),
+        'format': 'jwt_vc_json',
+      });
+      await expectLater(
+        walletWith().wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a request for another credential type', () async {
+      final request = requestFor({
+        ...membershipQuery(null),
+        'meta': {
+          'type_values': [
+            ['VerifiableCredential', 'TicketCredential'],
+          ],
+        },
+      });
+      await expectLater(
+        walletWith().wallet.createPresentation(credentialId, request),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a request for several credentials', () async {
+      final json = doorRequest();
+      json['dcql_query'] = {
+        'credentials': [
+          membershipQuery(null),
+          {...membershipQuery(null), 'id': 'second'},
+        ],
+      };
+      await expectLater(
+        walletWith().wallet.createPresentation(
+          credentialId,
+          PresentationRequest.fromJson(json),
+        ),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
+
+  group('holder proof', () {
+    test('is signed by the holder key for authentication', () async {
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        door,
+      );
+      expect(vp['holder'], holderDid);
+      final proof = vp['proof'] as Map<String, dynamic>;
+      expect(proof['type'], 'Ed25519Signature2020');
+      expect(proof['proofPurpose'], 'authentication');
+      expect(proof['verificationMethod'], HolderKey.fromSeed(holderSeed).keyId);
+      expect(proof['created'], testNow.millisecondsSinceEpoch ~/ 1000);
+      expect(proof['proofValue'], startsWith('z'));
+      expect(await holderSignatureVerifies(vp), isTrue);
+    });
+
+    test('binds the request nonce and client id under the signature', () async {
+      final vp = await walletWith().wallet.createPresentation(
+        credentialId,
+        door,
+      );
+      expect(vp['nonce'], 'n-8f3Kq2xWz0Lb');
+      expect(vp['domain'], 'door-scanner.members.test');
+
+      expect(await holderSignatureVerifies({...vp, 'nonce': 'n-other'}), false);
+      expect(
+        await holderSignatureVerifies({...vp, 'domain': 'door.elsewhere.test'}),
+        isFalse,
+      );
+      expect(
+        await holderSignatureVerifies({...vp, 'disclosures': const []}),
+        isFalse,
+      );
+    });
+
+    test('each request gets its own presentation', () async {
+      final wallet = walletWith().wallet;
+      final first = await wallet.createPresentation(credentialId, door);
+      final second = await wallet.createPresentation(
+        credentialId,
+        PresentationRequest.fromJson({...doorRequest(), 'nonce': 'n-next'}),
+      );
+      expect(second['nonce'], 'n-next');
+      expect(
+        second['proof']['proofValue'],
+        isNot(first['proof']['proofValue']),
+      );
+    });
+
+    test('refuses a credential about someone else', () async {
+      final wallet = walletWith(
+        issuance: membershipIssuance(subject: 'did:key:z6MkSomeoneElse'),
+      ).wallet;
+      await expectLater(
+        wallet.createPresentation(credentialId, door),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
+
+  group('validity', () {
+    test('refuses an expired credential', () async {
+      final wallet = walletWith(
+        issuance: membershipIssuance(
+          expiresAt: testNow.millisecondsSinceEpoch ~/ 1000 - 1,
+        ),
+      ).wallet;
+      await expectLater(
+        wallet.createPresentation(credentialId, door),
+        throwsA(
+          isA<WalletException>().having(
+            (e) => e.message,
+            'message',
+            contains('expired'),
+          ),
+        ),
+      );
+    });
+
+    test('presents up to and including the expiry second', () async {
+      final atExpiry = DateTime.fromMillisecondsSinceEpoch(
+        credentialExpiry * 1000,
+        isUtc: true,
+      );
+      final vp = await walletWith(now: atExpiry).wallet
+          .createPresentation(credentialId, door);
+      expect(vp['proof'], isNotNull);
+      await expectLater(
+        walletWith(now: atExpiry.add(const Duration(seconds: 1))).wallet
+            .createPresentation(credentialId, door),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses a credential without an expiry', () async {
+      final issuance = membershipIssuance();
+      (issuance['credential'] as Map).remove('expires_at');
+      await expectLater(
+        walletWith(issuance: issuance).wallet
+            .createPresentation(credentialId, door),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
+
+  group('wallet', () {
+    test('keeps the credential and can present it again', () async {
+      final (:wallet, :issuer) = walletWith();
+      await wallet.createPresentation(credentialId, door);
+      await wallet.createPresentation(credentialId, door);
+      expect(wallet.heldCredentials().map((c) => c.id), [credentialId]);
+      expect(wallet.credential(credentialId)!.toJson(), membershipIssuance());
+      expect(issuer.calls, isEmpty);
+    });
+
+    test(
+      'changing the presentation leaves the held credential alone',
+      () async {
+        final wallet = walletWith().wallet;
+        final vp = await wallet.createPresentation(credentialId, door);
+        (vp['verifiableCredential'] as Map)['expires_at'] = 0;
+        ((vp['disclosures'] as List).single as Map)['value'] = false;
+        expect(wallet.credential(credentialId)!.toJson(), membershipIssuance());
+      },
+    );
+
+    test('refuses an unknown credential', () async {
+      await expectLater(
+        walletWith().wallet.createPresentation('urn:uuid:unknown', door),
+        throwsA(isA<WalletException>()),
+      );
+    });
+
+    test('refuses when the wallet has no holder key', () async {
+      final store = CredentialStore()
+        ..save(HeldCredential.fromIssuance(membershipIssuance()));
+      final wallet = WalletService(
+        issuer: FakeIssuerClient(),
+        store: store,
+        clock: () => testNow,
+      );
+      await expectLater(
+        wallet.createPresentation(credentialId, door),
+        throwsA(isA<WalletException>()),
+      );
+    });
+  });
+}
