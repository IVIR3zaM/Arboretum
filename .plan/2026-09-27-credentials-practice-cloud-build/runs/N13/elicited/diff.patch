diff --git a/app/test/presentation_test.dart b/app/test/presentation_test.dart
new file mode 100644
index 0000000..7ca88ea
--- /dev/null
+++ b/app/test/presentation_test.dart
@@ -0,0 +1,184 @@
+import 'dart:convert';
+
+import 'package:credentials_app/credentials_app.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ssi/ssi.dart';
+
+import 'fake_issuer_client.dart';
+import 'fixtures.dart';
+
+DateTime at(int unixSeconds) =>
+    DateTime.fromMillisecondsSinceEpoch(unixSeconds * 1000, isUtc: true);
+
+/// 2026-06-01T00:00:00Z, well inside the fixture credential's validity.
+final now = at(1780272000);
+
+Future<WalletService> walletHolding({DateTime? clock}) async {
+  final wallet = WalletService(
+    issuer: FakeIssuerClient(),
+    newKey: () => HolderKey.fromSeed(holderSeed),
+    clock: () => clock ?? now,
+  );
+  await wallet.requestCredential('MembershipCredential');
+  return wallet;
+}
+
+PresentationRequest requestFor(List<Map<String, dynamic>> claims) {
+  final json = doorRequest();
+  final credential = (json['dcql_query']['credentials'] as List).single as Map;
+  credential['claims'] = claims;
+  return PresentationRequest.fromJson(json);
+}
+
+Map<String, dynamic> withoutProof(Map<String, dynamic> vp) =>
+    Map.of(vp)..remove('proof');
+
+Future<bool> holderSignatureValid(Map<String, dynamic> vp) {
+  final signature = multiBaseToUint8List(vp['proof']['proofValue'] as String);
+  return HolderKey.fromSeed(holderSeed)
+      .verify(utf8.encode(JcsUtil.canonicalize(withoutProof(vp))), signature);
+}
+
+void main() {
+  final door = PresentationRequest.fromJson(doorRequest());
+
+  test('discloses only the claims the request names', () async {
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(credentialId, door);
+
+    expect(vp['disclosures'], [
+      membershipIssuance()['disclosures'][0], // member, unchanged
+    ]);
+    final wire = jsonEncode(vp);
+    for (final withheld in ['M-20417', 'Ada Park', '1990-04-12']) {
+      expect(wire, isNot(contains(withheld)));
+    }
+  });
+
+  test('carries the credential unchanged', () async {
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(credentialId, door);
+    expect(vp['verifiableCredential'], membershipIssuance()['credential']);
+    expect(vp['holder'], holderDid);
+  });
+
+  test('is bound to the request nonce and client id', () async {
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(credentialId, door);
+    expect(vp['nonce'], 'n-8f3Kq2xWz0Lb');
+    expect(vp['domain'], 'door-scanner.members.test');
+  });
+
+  test('is signed by the holder key for authentication', () async {
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(credentialId, door);
+
+    final proof = vp['proof'] as Map<String, dynamic>;
+    expect(proof['type'], 'Ed25519Signature2020');
+    expect(proof['proofPurpose'], 'authentication');
+    expect(proof['verificationMethod'], HolderKey.fromSeed(holderSeed).keyId);
+    expect(proof['created'], 1780272000);
+    expect(await holderSignatureValid(vp), isTrue);
+  });
+
+  test('the signature covers the nonce and the client id', () async {
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(credentialId, door);
+    expect(await holderSignatureValid({...vp, 'nonce': 'other'}), isFalse);
+    expect(await holderSignatureValid({...vp, 'domain': 'other'}), isFalse);
+  });
+
+  test('refuses an expired credential', () async {
+    final wallet = await walletHolding(clock: at(expiresAt + 1));
+    await expectLater(
+      wallet.createPresentation(credentialId, door),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('presents a credential up to its expiry second', () async {
+    final wallet = await walletHolding(clock: at(expiresAt));
+    expect(await wallet.createPresentation(credentialId, door), isNotEmpty);
+  });
+
+  test('keeps the credential for later visits', () async {
+    final wallet = await walletHolding();
+    await wallet.createPresentation(credentialId, door);
+    expect(wallet.credential(credentialId), isNotNull);
+
+    final nextVisit = PresentationRequest.fromJson(
+      doorRequest()..['nonce'] = 'n-next-visit',
+    );
+    final vp = await wallet.createPresentation(credentialId, nextVisit);
+    expect(vp['nonce'], 'n-next-visit');
+  });
+
+  test('a query without claims discloses nothing', () async {
+    final json = doorRequest();
+    ((json['dcql_query']['credentials'] as List).single as Map).remove(
+      'claims',
+    );
+    final wallet = await walletHolding();
+    final vp = await wallet.createPresentation(
+      credentialId,
+      PresentationRequest.fromJson(json),
+    );
+    expect(vp['disclosures'], isEmpty);
+  });
+
+  test('refuses a claim the credential cannot disclose', () async {
+    final wallet = await walletHolding();
+    await expectLater(
+      wallet.createPresentation(
+        credentialId,
+        requestFor([
+          {
+            'path': ['credentialSubject', 'tier'],
+          },
+        ]),
+      ),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a claim whose value is not one requested', () async {
+    final wallet = await walletHolding();
+    await expectLater(
+      wallet.createPresentation(
+        credentialId,
+        requestFor([
+          {
+            'path': ['credentialSubject', 'memberId'],
+            'values': ['M-1'],
+          },
+        ]),
+      ),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses a request for several credentials', () async {
+    final json = doorRequest();
+    final credentials = json['dcql_query']['credentials'] as List;
+    credentials.add({
+      ...credentials.single as Map<String, Object>,
+      'id': 'second',
+    });
+    final wallet = await walletHolding();
+    await expectLater(
+      wallet.createPresentation(
+        credentialId,
+        PresentationRequest.fromJson(json),
+      ),
+      throwsA(isA<WalletException>()),
+    );
+  });
+
+  test('refuses an unknown credential', () async {
+    final wallet = await walletHolding();
+    await expectLater(
+      wallet.createPresentation('urn:uuid:unknown', door),
+      throwsA(isA<WalletException>()),
+    );
+  });
+}
