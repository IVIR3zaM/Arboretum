   /// Builds a presentation of the held credential [credentialId] in answer
   /// to [request], ready to send to the requester.
+  ///
+  /// The presentation carries the credential unchanged, the disclosures of
+  /// exactly the claims the request's DCQL query names, and the request's
+  /// nonce and client id, all signed with the holder key
+  /// (`Ed25519Signature2020`, `authentication`, over the RFC 8785 form of the
+  /// presentation without its `proof`). Everything happens on the device;
+  /// the credential stays in the wallet for later visits.
+  ///
+  /// Throws [WalletException] if the credential is unknown, not bound to this
+  /// holder, expired, or cannot answer the query.
   Future<Map<String, dynamic>> createPresentation(
     String credentialId,
     PresentationRequest request,
   ) async {
-    throw UnimplementedError('createPresentation');
+    final credential = _store.byId(credentialId);
+    if (credential == null) {
+      throw WalletException('No credential $credentialId in the wallet');
+    }
+    final key = holderKey();
+    if (credential.holderDid != key.did) {
+      throw WalletException(
+        'Credential ${credential.id} is bound to ${credential.holderDid}, not ${key.did}',
+      );
+    }
+    final now = _clock().millisecondsSinceEpoch ~/ 1000;
+    final expiresAt = credential.vc['expires_at'];
+    if (expiresAt is! int) {
+      throw WalletException('Credential ${credential.id} has no expiry');
+    }
+    if (now > expiresAt) {
+      throw WalletException('Credential ${credential.id} has expired');
+    }
+
+    final disclosures = _requestedDisclosures(credential, request.dcqlQuery);
+    final presentation = <String, dynamic>{
+      '@context': ['https://www.w3.org/2018/credentials/v1'],
+      'type': ['VerifiablePresentation'],
+      'holder': key.did,
+      'verifiableCredential': jsonDecode(jsonEncode(credential.vc)),
+      'disclosures': [for (final d in disclosures) d.toJson()],
+      'nonce': request.nonce,
+      'domain': request.domain,
+    };
+    final signature = await key.sign(
+      utf8.encode(JcsUtil.canonicalize(presentation)),
+    );
+    presentation['proof'] = {
+      'type': 'Ed25519Signature2020',
+      'created': now,
+      'verificationMethod': key.keyId,
+      'proofPurpose': 'authentication',
+      'proofValue': toMultiBase(signature),
+    };
+    return presentation;
+  }
+
+  /// The disclosures of [credential] for the claims [query] names, in query
+  /// order. Only single-credential queries over `credentialSubject` claims
+  /// are answered; a query without `claims` asks for no selectively
+  /// disclosable claims.
+  List<Disclosure> _requestedDisclosures(
+    HeldCredential credential,
+    DcqlCredentialQuery query,
+  ) {
+    if (query.credentialSets != null || query.credentials.length != 1) {
+      throw const WalletException(
+        'Only requests for a single credential are supported',
+      );
+    }
+    final wanted = query.credentials.single;
+    if (wanted.format != CredentialFormat.ldpVc) {
+      throw WalletException(
+        'Request asks for ${wanted.format.name}, not a JSON-LD credential',
+      );
+    }
+    final typeValues = wanted.meta?.typeValues;
+    final types = credential.vc['type'];
+    final heldTypes = types is List ? types.toSet() : {types};
+    if (typeValues != null &&
+        !typeValues.any((option) => heldTypes.containsAll(option))) {
+      throw WalletException(
+        'Credential ${credential.id} is not of the requested type',
+      );
+    }
+    if (wanted.claimSets != null) {
+      throw const WalletException('Claim sets are not supported');
+    }
+
+    final selected = <String, Disclosure>{};
+    for (final claim in wanted.claims ?? const <DcqlClaim>[]) {
+      final path = claim.path;
+      if (path.length != 2 ||
+          path[0] != 'credentialSubject' ||
+          path[1] is! String) {
+        throw WalletException('Unsupported claim path $path');
+      }
+      final name = path[1] as String;
+      final matches = credential.disclosures.where((d) => d.name == name);
+      if (matches.length != 1) {
+        throw WalletException(
+          'Credential ${credential.id} has no disclosable claim $name',
+        );
+      }
+      final disclosure = matches.single;
+      final values = claim.values;
+      if (values != null && !values.contains(disclosure.value)) {
+        throw WalletException('Claim $name does not have a requested value');
+      }
+      selected[name] = disclosure;
+    }
+    return selected.values.toList();
   }
 }
